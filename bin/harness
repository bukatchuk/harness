#!/usr/bin/env bash
# harness — CLI: setup, environment check, registries, language sets, Docker, public release.
# Dependencies: bash 3.2+, git, jq. Everything deterministic lives here, not in the rules.
# Every user-facing message is written as a pair: Russian first, English second.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF="${HARNESS_CONF:-$ROOT/harness.json}"
REGISTRY="$ROOT/registry/repos.json"
SERVERS="$ROOT/registry/servers.json"
SERVICES="$ROOT/registry/services.json"
REPOS_DIR="${HARNESS_REPOS_DIR:-$ROOT/repos}"
WORKTREES_DIR="${HARNESS_WORKTREES_DIR:-$ROOT/worktrees}"
I18N="$ROOT/i18n"
ACTIVE="$ROOT/.claude"
SETTINGS="$ACTIVE/settings.json"
LOCAL_SETTINGS="$ACTIVE/settings.local.json"
MANIFEST="$ACTIVE/.harness-files"
BACKUP_DIR="$ROOT/.harness-backup"
DIST="$ROOT/dist"

# How often a running session checks origin for a new version, in seconds.
UPDATE_CHECK_INTERVAL=900
# A clone with uncommitted changes stays held for this long after the last command of its session.
LOCK_TTL=1800
# GIT_MOVING takes the working copy off its branch or rewrites it; GIT_MUTATING adds the commands
# that only continue the work in the current branch.
GIT_MOVING='git[^|;&]*[[:space:]](switch|checkout|merge|pull|reset|rebase|cherry-pick|revert|restore|clean|am|apply)([[:space:]]|$)|git[^|;&]*[[:space:]]stash([[:space:]]+(push|pop|apply|drop|clear|save|-)|[[:space:]]*($|[;&|]))|git[^|;&]*[[:space:]]branch[^|;&]*[[:space:]](-[dDmMfF]|--delete|--move|--force)([[:space:]]|$)|gh[^|;&]*[[:space:]]pr[[:space:]]+(merge|checkout)([[:space:]]|$)'
GIT_MUTATING="$GIT_MOVING"'|git[^|;&]*[[:space:]](add|commit|rm|mv)([[:space:]]|$)'

# AI attribution markers that are forbidden in commits and PRs.
AI_MARKERS='co-authored-by:.*(claude|anthropic|copilot|openai|codex|cursor|gemini)|generated with.*(claude|codex|cursor|copilot|gemini)|noreply@anthropic\.com|🤖'

# Marker of the block that the public build appends to .gitignore.
IGNORE_MARK='# harness: user data'

# --- settings and language ----------------------------------------------------

# Value from harness.json; empty when the file, the key or jq is missing.
conf() {
  [ -f "$CONF" ] && command -v jq >/dev/null 2>&1 || return 0
  jq -r "$1 // empty" "$CONF" 2>/dev/null
}

detect_lang() {
  local l="${HARNESS_LANG:-}"
  [ -n "$l" ] || l="$(conf '.lang')"
  if [ -z "$l" ]; then
    case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in ru*) l=ru ;; *) l=en ;; esac
  fi
  case "$l" in ru|en) echo "$l" ;; *) echo en ;; esac
}
HLANG="$(detect_lang)"

# t "<русский>" "<english>" — the string in the current language.
t()   { if [ "$HLANG" = ru ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
say() { t "$1" "$2"; echo; }
err() { say "$1" "$2" >&2; }

need_jq() { command -v jq >/dev/null 2>&1 || { err "нужен jq" "jq is required"; exit 1; }; }

integration_on() { [ -n "$(conf ".integrations.$1")" ]; }

usage() {
  if [ "$HLANG" = ru ]; then cat <<'EOF'
Использование: bin/harness <команда>

Настройка
  init [--name И --email П --lang ru|en --yes]   первичная настройка: владелец, язык, git-хуки
  lang [ru|en]             показать или сменить язык правил, skills и сообщений
  version                  версия harness и наличие обновления в origin
  doctor [--deep]          проверка окружения; --deep — с реальными запросами к API
  selfcheck                проверка целостности самого harness (для CI и перед релизом)

Реестр
  sync [имя]               клонировать и обновить репозитории из реестра
  status                   состояние клонов в repos/
  servers                  список серверов из реестра
  server-check [имя]       проверить вход на серверы по SSH
  map [имя]                связи: какой репозиторий настраивает какие серверы и сервисы
  repo-remove <имя> [--unlink] [--delete-clone] [--force]
                           удалить репозиторий из реестра
  server-remove <имя> [--unlink]
                           удалить сервер из реестра
  service-remove <имя>     удалить связь из реестра
  reset [--delete-clones] [--force] [--yes]
                           очистить реестр; без --yes только показывает план

Git и Docker
  check-commits [путь]     проверить неотправленные коммиты: автор и AI-атрибуция
  docker-up                запустить демон Docker и дождаться готовности
  docker-check             показать ресурсы Docker, оставшиеся от harness
  docker-clean [--all]     удалить ресурсы Docker этой сессии и остановленные без метки сессии; --all — все ресурсы harness

Параллельные сессии
  locks                    клоны в repos/, занятые сессиями
  unlock <имя>             снять блокировку клона (только по слову владельца)
  worktree <имя> <ветка> [--remove]
                           отдельная рабочая копия клона для параллельной сессии

GitLab (интеграция gitlab)
  forge [путь]             где живёт origin репозитория: gitlab, github или other
  mr <путь> --title <заголовок> --body-file <файл> [--base <ветка>]
                           запрос на слияние из текущей ветки
  mr-status <путь> <номер> конвейер и готовность запроса к слиянию
  release-create <путь> <тег> --title <заголовок> --notes-file <файл>
                           релиз на существующий тег

Секреты (хранилище Bitwarden или совместимый сервер)
  secrets [--check]        токены включённых интеграций для eval "$(bin/harness secrets)"; --check — только имена

Plane (интеграция plane)
  task create|state|comment|link|show|list …
                           задачи: создать, сменить состояние, комментарий, ссылка, показать, список
  tasks [--stale N] [--count]
                           задачи в работе по всем проектам и сколько дней они без движения

Публичный релиз
  release-build [--preview]   собрать открытую версию без данных владельца и проверить на утечки
  release-publish [--push]    показать или отправить релиз в публичный репозиторий
EOF
  else cat <<'EOF'
Usage: bin/harness <command>

Setup
  init [--name N --email E --lang ru|en --yes]   first-time setup: owner, language, git hooks
  lang [ru|en]             show or switch the language of rules, skills and messages
  version                  harness version and whether origin has an update
  doctor [--deep]          environment check; --deep makes real API requests
  selfcheck                integrity check of harness itself (for CI and before a release)

Registry
  sync [name]              clone and update repositories from the registry
  status                   state of the clones in repos/
  servers                  list servers from the registry
  server-check [name]      check SSH login to the servers
  map [name]               links: which repository configures which servers and services
  repo-remove <name> [--unlink] [--delete-clone] [--force]
                           remove a repository from the registry
  server-remove <name> [--unlink]
                           remove a server from the registry
  service-remove <name>    remove a link from the registry
  reset [--delete-clones] [--force] [--yes]
                           empty the registry; without --yes it only prints the plan

Git and Docker
  check-commits [path]     check unpushed commits: author and AI attribution
  docker-up                start the Docker daemon and wait until it is ready
  docker-check             show Docker resources left behind by harness
  docker-clean [--all]     remove this session's Docker resources and stopped ones without a session label; --all — every harness resource

Parallel sessions
  locks                    clones in repos/ held by sessions
  unlock <name>            remove the lock of a clone (only when the owner says so)
  worktree <name> <branch> [--remove]
                           a separate working copy of a clone for a parallel session

GitLab (the gitlab integration)
  forge [path]             where the repository's origin lives: gitlab, github or other
  mr <path> --title <title> --body-file <file> [--base <branch>]
                           a merge request from the current branch
  mr-status <path> <number>
                           the pipeline and whether the request can be merged
  release-create <path> <tag> --title <title> --notes-file <file>
                           a release for an existing tag

Secrets (a Bitwarden or compatible vault)
  secrets [--check]        tokens of the enabled integrations for eval "$(bin/harness secrets)"; --check — names only

Plane (the plane integration)
  task create|state|comment|link|show|list …
                           tasks: create, change the state, comment, link, show, list
  tasks [--stale N] [--count]
                           tasks in progress across all projects and how many days they have not moved

Public release
  release-build [--preview]   build the open version without owner data and scan it for leaks
  release-publish [--push]    preview or push the release to the public repository
EOF
  fi
}

# --- version ------------------------------------------------------------------

local_version() { tr -d '[:space:]' < "$ROOT/VERSION"; }

default_branch() {
  local b
  b="$(git -C "$ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
  echo "${b:-main}"
}

# git fetch with a time limit: session start must not hang without a network.
# A normal fetch from the remote over SSH takes 4–5 seconds, so a limit under 10 gives a false "no updates".
# Returns non-zero when the fetch did not finish or failed.
fetch_origin() {
  local secs="${1:-20}" pid
  git -C "$ROOT" fetch --quiet origin >/dev/null 2>&1 &
  pid=$!
  ( sleep "$secs"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  wait "$pid" 2>/dev/null
}

version_line() {
  local sha dirty=""
  sha="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || t 'нет git' 'no git')"
  [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ] && dirty="$(t ', есть незакоммиченные изменения' ', uncommitted changes')"
  echo "harness v$(local_version) ($sha$dirty)"
}

# Prints a line about the update when origin is ahead.
update_line() {
  local branch behind remote_v
  branch="$(default_branch)"
  behind="$(git -C "$ROOT" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
  [ "$behind" -gt 0 ] 2>/dev/null || return 0
  remote_v="$(git -C "$ROOT" show "origin/$branch:VERSION" 2>/dev/null | tr -d '[:space:]')"
  say "доступно обновление: v${remote_v:-?} (коммитов: $behind) — skill harness-update" \
      "update available: v${remote_v:-?} (commits: $behind) — skill harness-update"
}

# $1 > $2 for versions of the form X.Y.Z
ver_gt() {
  local IFS=. i
  # shellcheck disable=SC2206  # split by IFS on purpose
  local a=($1) b=($2)
  for i in 0 1 2; do
    [ "${a[i]:-0}" -gt "${b[i]:-0}" ] && return 0
    [ "${a[i]:-0}" -lt "${b[i]:-0}" ] && return 1
  done
  return 1
}

# Session state file: time of the last check and the sha that was already announced.
state_file() {
  local dir sid
  dir="$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null)/harness"
  mkdir -p "$dir" 2>/dev/null
  sid="$(printf '%s' "${1:-default}" | tr -cd 'A-Za-z0-9_-')"
  echo "$dir/update-check-${sid:-default}"
}

cmd_version() {
  local fetched=1
  fetch_origin 30 || fetched=0
  version_line
  update_line
  if [ "$fetched" -eq 0 ]; then
    say "origin недоступен: сведения об обновлении могут быть устаревшими (проверь сеть и доступ: git fetch origin)" \
        "origin is unreachable: update information may be stale (check the network and access: git fetch origin)"
    return 1
  fi
}

# --- tables -------------------------------------------------------------------

US=$'\x1f'

# String width in characters, not bytes, under any locale: UTF-8 continuation bytes are not counted.
char_len() {
  local LC_ALL=C s="$1"
  s="${s//[$'\x80'-$'\xbf']/}"
  echo "${#s}"
}

# Reads rows with fields separated by $US (the first row is the header) and prints an aligned table.
# The last column is not padded: it may hold long text.
print_table() {
  local line cell i n=0 cols=0 len out
  local -a rows widths cells
  while IFS= read -r line; do
    rows[n]="$line"; n=$((n + 1))
    IFS="$US" read -ra cells <<< "$line"
    [ "${#cells[@]}" -le "$cols" ] || cols="${#cells[@]}"
    for i in "${!cells[@]}"; do
      len="$(char_len "${cells[i]}")"
      [ "$len" -le "${widths[i]:-0}" ] || widths[i]="$len"
    done
  done
  [ "$n" -gt 0 ] || return 0
  for line in "${rows[@]}"; do
    IFS="$US" read -ra cells <<< "$line"
    out=""
    for ((i = 0; i < cols; i++)); do
      cell="${cells[i]:-}"
      if [ "$i" -eq $((cols - 1)) ]; then
        out+="$cell"
      else
        out+="$(printf '%s%*s' "$cell" $((widths[i] - $(char_len "$cell") + 2)) '')"
      fi
    done
    echo "  $out"
  done
}

# "  <label padded to 12 characters> <text>"
row() { printf '  %s%*s %s\n' "$1" $((12 - $(char_len "$1"))) '' "$2"; }

# --- registry files -----------------------------------------------------------

# A fresh install has no registry yet: an absent file means an empty registry.
ensure_data() {
  mkdir -p "$ROOT/registry" 2>/dev/null
  [ -f "$REGISTRY" ] || echo '{"repos": []}' > "$REGISTRY"
  [ -f "$SERVERS" ]  || echo '{"servers": []}' > "$SERVERS"
  [ -f "$SERVICES" ] || echo '{"services": []}' > "$SERVICES"
}

need_registry() {
  need_jq; ensure_data
  jq -e '.repos | type == "array"' "$REGISTRY" >/dev/null 2>&1 || { err "registry/repos.json повреждён" "registry/repos.json is corrupted"; exit 1; }
}
need_servers() {
  need_jq; ensure_data
  jq -e '.servers | type == "array"' "$SERVERS" >/dev/null 2>&1 || { err "registry/servers.json повреждён" "registry/servers.json is corrupted"; exit 1; }
}
need_services() {
  need_jq; ensure_data
  jq -e '.services | type == "array"' "$SERVICES" >/dev/null 2>&1 || { err "registry/services.json повреждён" "registry/services.json is corrupted"; exit 1; }
}

# json_edit <file> <jq arguments…> — rewrites the file in place, keeping its permissions.
json_edit() {
  local file="$1" tmp
  shift
  tmp="$(mktemp "${TMPDIR:-/tmp}/harness.XXXXXX")" || return 1
  if jq "$@" "$file" > "$tmp"; then
    cat "$tmp" > "$file"; rm -f "$tmp"
  else
    rm -f "$tmp"; return 1
  fi
}

# Copies the three registry files aside before any destructive change. Prints the directory.
backup_registry() {
  local dir
  dir="$BACKUP_DIR/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$dir" && cp "$REGISTRY" "$SERVERS" "$SERVICES" "$dir/" 2>/dev/null
  echo "${dir#"$ROOT"/}"
}

# A registry name is used as a directory name: no slashes, no dots-only, no leading dash.
valid_name() {
  case "${1:-}" in ""|.|..|*/*|-*) return 1 ;; esac
  return 0
}

# --- language sets ------------------------------------------------------------

lang_files() { (cd "$I18N/$1" 2>/dev/null && find . -type f -name '*.md' | sed 's|^\./||' | LC_ALL=C sort); }

# True when .claude/ does not match i18n/<lang>: nothing deployed yet, another language, or edited sources.
lang_stale() {
  local src="$I18N/$1" f
  [ -d "$src" ] || return 1
  [ -f "$MANIFEST" ] || return 0
  [ "$(lang_files "$1")" = "$(cat "$MANIFEST")" ] || return 0
  while IFS= read -r f; do
    cmp -s "$src/$f" "$ACTIVE/$f" || return 0
  done < "$MANIFEST"
  return 1
}

# Copies i18n/<lang> into .claude/. Removes only the files it deployed before: the user's own rules and skills stay.
apply_lang() {
  local lang="$1" src="$I18N/$1" f
  [ -d "$src" ] || return 1
  mkdir -p "$ACTIVE"
  if [ -f "$MANIFEST" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] && rm -f "$ACTIVE/$f"
    done < "$MANIFEST"
  fi
  lang_files "$lang" > "$MANIFEST"
  while IFS= read -r f; do
    mkdir -p "$ACTIVE/$(dirname "$f")" && cp "$src/$f" "$ACTIVE/$f"
  done < "$MANIFEST"
  find "$ACTIVE/rules" "$ACTIVE/skills" "$ACTIVE/integrations" -type d -empty -delete 2>/dev/null
  return 0
}

# Files that exist in one language set only.
i18n_mismatch() {
  local f
  for f in $(lang_files ru); do [ -f "$I18N/en/$f" ] || echo "i18n/ru/$f"; done
  for f in $(lang_files en); do [ -f "$I18N/ru/$f" ] || echo "i18n/en/$f"; done
}

cmd_lang() {
  need_jq
  local want="${1:-}"
  if [ -n "$want" ]; then
    case "$want" in
      ru|en) ;;
      *) err "неизвестный язык: $want (есть ru и en)" "unknown language: $want (ru and en are available)"; return 1 ;;
    esac
    [ -f "$CONF" ] || echo '{}' > "$CONF"
    json_edit "$CONF" --arg l "$want" '.lang = $l' || return 1
    HLANG="$want"
  fi
  apply_lang "$HLANG" || { err "нет комплекта i18n/$HLANG" "language set i18n/$HLANG is missing"; return 1; }
  say "язык: $HLANG — правила, skills и шпаргалки развёрнуты в .claude/ ($(grep -c . "$MANIFEST") файлов)" \
      "language: $HLANG — rules, skills and cheat sheets are deployed to .claude/ ($(grep -c . "$MANIFEST") files)"
  [ -z "$want" ] || say "В работающей сессии Claude Code правила перечитаются после перезапуска." \
                        "A running Claude Code session picks up the rules after a restart."
}

# --- owner identity -----------------------------------------------------------

# Pins the commit author from harness.json in .claude/settings.local.json.
# Returns 0 — already pinned, 2 — just written, 1 — owner is not configured or the file is broken.
apply_identity() {
  local name email cur
  name="$(conf '.owner.name')"; email="$(conf '.owner.email')"
  [ -n "$name" ] && [ -n "$email" ] || return 1
  mkdir -p "$ACTIVE"
  [ -f "$LOCAL_SETTINGS" ] || echo '{}' > "$LOCAL_SETTINGS"
  cur="$(jq -r '[.env.GIT_AUTHOR_NAME, .env.GIT_AUTHOR_EMAIL, .env.GIT_COMMITTER_NAME, .env.GIT_COMMITTER_EMAIL] | map(. // "") | join("|")' "$LOCAL_SETTINGS" 2>/dev/null)" || return 1
  [ "$cur" = "$name|$email|$name|$email" ] && return 0
  json_edit "$LOCAL_SETTINGS" --arg n "$name" --arg e "$email" \
    '.env = ((.env // {}) + {GIT_AUTHOR_NAME: $n, GIT_AUTHOR_EMAIL: $e, GIT_COMMITTER_NAME: $n, GIT_COMMITTER_EMAIL: $e})' || return 1
  return 2
}

# --- init ---------------------------------------------------------------------

# ask "<prompt>" "<default>" — reads an answer from the terminal, even when stdin is a pipe (curl | bash).
ask() {
  local answer
  printf '%s [%s]: ' "$1" "$2" > /dev/tty
  IFS= read -r answer < /dev/tty || answer=""
  echo "${answer:-$2}"
}

cmd_init() {
  need_jq
  local name="" email="" lang="" yes=0 interactive=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)  name="${2:-}"; shift ;;
      --email) email="${2:-}"; shift ;;
      --lang)  lang="${2:-}"; shift ;;
      --yes|-y) yes=1 ;;
      *) err "неизвестный параметр: $1" "unknown option: $1"; return 1 ;;
    esac
    shift
  done
  [ -n "$name" ]  || name="$(conf '.owner.name')"
  [ -n "$email" ] || email="$(conf '.owner.email')"
  [ -n "$name" ]  || name="$(git config --global user.name 2>/dev/null)"
  [ -n "$email" ] || email="$(git config --global user.email 2>/dev/null)"
  [ -n "$lang" ]  || lang="$HLANG"

  if [ "$yes" -eq 0 ] && { : < /dev/tty; } 2>/dev/null; then interactive=1; fi
  if [ "$interactive" -eq 1 ]; then
    lang="$(ask 'Язык / Language (ru, en)' "$lang")"
    case "$lang" in ru|en) HLANG="$lang" ;; esac
    name="$(ask "$(t 'Имя автора коммитов' 'Commit author name')" "$name")"
    email="$(ask "$(t 'Почта автора коммитов' 'Commit author email')" "$email")"
  fi

  case "$lang" in
    ru|en) HLANG="$lang" ;;
    *) err "язык должен быть ru или en" "language must be ru or en"; return 1 ;;
  esac
  if [ -z "$name" ]; then
    err "не задано имя автора: bin/harness init --name \"Имя Фамилия\" --email you@example.com" \
        "author name is missing: bin/harness init --name \"First Last\" --email you@example.com"
    return 1
  fi
  case "$email" in
    ?*@?*.?*) ;;
    *) err "почта автора не задана или записана неверно: --email you@example.com" \
           "author email is missing or malformed: --email you@example.com"; return 1 ;;
  esac

  [ -f "$CONF" ] || echo '{}' > "$CONF"
  json_edit "$CONF" --arg n "$name" --arg e "$email" --arg l "$lang" \
    '{owner: {name: $n, email: $e}, lang: $l, integrations: (.integrations // {})} + (del(.owner, .lang, .integrations))' || return 1
  ensure_data
  apply_identity; [ $? -ne 1 ] || { err "не удалось записать .claude/settings.local.json" "could not write .claude/settings.local.json"; return 1; }
  apply_lang "$lang" || { err "нет комплекта i18n/$lang" "language set i18n/$lang is missing"; return 1; }
  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 && git -C "$ROOT" config --local core.hooksPath .githooks

  say "harness настроен:" "harness is set up:"
  row "$(t 'владелец' 'owner')" "$name <$email>"
  row "$(t 'язык' 'language')" "$lang"
  row "$(t 'правила' 'rules')" "$(t "развёрнуты в .claude/ ($(grep -c . "$MANIFEST") файлов)" "deployed to .claude/ ($(grep -c . "$MANIFEST") files)")"
  echo
  say "Дальше:" "Next:"
  say "  bin/harness doctor     — чего не хватает в окружении" "  bin/harness doctor     — what the environment is missing"
  say "  claude                 — запускать из корня harness: $ROOT" "  claude                 — start it from the harness root: $ROOT"
  say "  /repo-add <git-url>    — добавить первый проект" "  /repo-add <git-url>    — add your first project"
}

# --- doctor -------------------------------------------------------------------

ERRORS=0
WARNINGS=0
QUIET=0
ok()   { [ "$QUIET" -eq 1 ] || echo "  ok    $*"; }
warn() { echo "  warn  $*"; WARNINGS=$((WARNINGS + 1)); }
fail() { echo "  FAIL  $*"; ERRORS=$((ERRORS + 1)); }
section() { [ "$QUIET" -eq 1 ] || echo "$*"; }

# The token goes to curl through a file descriptor, not an argument: it is not visible in ps.
http_check() {
  local name="$1" url="$2" header="$3" code
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -H @<(printf '%s' "$header") "$url" 2>/dev/null)"
  case "$code" in
    2*)  ok "$name: HTTP $code" ;;
    000) fail "$name: $(t "нет соединения с $url" "no connection to $url")" ;;
    *)   fail "$name: HTTP $code ($url)" ;;
  esac
}

# dk [-t <seconds>] <docker args> — docker with a time limit. A daemon can answer `docker info` and still hang on
# `docker ps`; without a limit the session start hook waits for it forever. Code 124 — the command was killed.
dk() {
  local secs="${HARNESS_DOCKER_TIMEOUT:-10}" pid watcher rc
  if [ "${1:-}" = -t ]; then secs="$2"; shift 2; fi
  docker "$@" 2>/dev/null &
  pid=$!
  ( sleep "$secs"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  watcher=$!
  wait "$pid" 2>/dev/null; rc=$?
  kill "$watcher" 2>/dev/null
  # 143 — SIGTERM from the watcher: the docker client does not exit with it on its own.
  [ "$rc" -eq 143 ] && return 124
  return "$rc"
}

# docker_state — 0: the daemon answers; 1: it is stopped; 2: it hangs (info or ps do not finish in time).
docker_state() {
  local rc
  dk info >/dev/null; rc=$?
  [ "$rc" -eq 124 ] && return 2
  [ "$rc" -eq 0 ] || return 1
  dk ps -q --latest >/dev/null; rc=$?
  [ "$rc" -eq 124 ] && return 2
  return 0
}

docker_hung_msg() {
  err "Docker не отвечает: команда docker не завершилась за ${HARNESS_DOCKER_TIMEOUT:-10} с — перезапусти Docker Desktop" \
      "Docker does not respond: a docker command did not finish within ${HARNESS_DOCKER_TIMEOUT:-10} s — restart Docker Desktop"
}

# harness_session — this Claude Code session: 8 characters, as in `locks`. The session start hook exports
# HARNESS_SESSION; empty outside a session.
harness_session() {
  printf '%s' "${HARNESS_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}" | tr -cd 'A-Za-z0-9_-' | cut -c1-8
}

# harness_resources — "<kind> <id> <session or -> <state or ->" for every harness resource: the label harness=1
# or a compose project harness-*. The session is the harness.session label or the suffix of a compose project
# named harness-<project>-<session>.
harness_resources() {
  local f='{{.Label "harness"}}\t{{.Label "harness.session"}}\t{{.Label "com.docker.compose.project"}}' ids
  {
    dk ps -a --format "{{.ID}}\t$f\t{{.State}}" | sed 's/^/containers\t/'
    dk network ls --format "{{.ID}}\t$f\t-" | sed 's/^/networks\t/'
    dk volume ls --format "{{.Name}}\t$f\t-" | sed 's/^/volumes\t/'
  } | awk -F'\t' '
    $3 == "1" || $5 ~ /^harness-/ {
      s = substr($4, 1, 8)
      if (s == "" && match($5, /-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/)) s = substr($5, RSTART + 1)
      print $1, $2, (s == "" ? "-" : s), ($6 == "" ? "-" : $6)
    }'
  ids="$(dk images -q --filter label=harness=1 | sort -u)"
  # shellcheck disable=SC2086  # ids are separate words on purpose
  [ -z "$ids" ] || dk image inspect --format '{{.Id}} {{index .Config.Labels "harness.session"}}' $ids \
    | awk '{ s = substr($2, 1, 8); if (s == "" || s == "<no") s = "-"; print "images", $1, s, "-" }'
}

# harness_classified — harness_resources with the owner instead of the session: own (this session),
# other (another session), none (no session label: an older harness or created by hand).
harness_classified() {
  harness_resources | awk -v me="$(harness_session)" '{ print $1, $2, ($3 == "-" ? "none" : ($3 == me ? "own" : "other")), $4 }'
}

cmd_doctor() {
  local deep=0 arg tool v
  for arg in "$@"; do
    case "$arg" in
      --deep)  deep=1 ;;
      --quiet) QUIET=1 ;;
    esac
  done

  section "$(t 'Утилиты' 'Tools')"
  for tool in git jq curl; do
    if command -v "$tool" >/dev/null 2>&1; then ok "$tool"; else fail "$tool $(t 'не установлен' 'is not installed')"; fi
  done
  for tool in gh docker; do
    if command -v "$tool" >/dev/null 2>&1; then ok "$tool"; else warn "$tool $(t 'не установлен' 'is not installed')"; fi
  done
  if integration_on yandex_cloud; then
    if command -v yc >/dev/null 2>&1; then ok "yc"; else warn "yc $(t 'не установлен (см. .claude/integrations/yandex-cloud.md)' 'is not installed (see .claude/integrations/yandex-cloud.md)')"; fi
  fi
  if integration_on gitguardian; then
    if command -v ggshield >/dev/null 2>&1; then ok "ggshield"; else warn "ggshield $(t 'не установлен (см. .claude/integrations/gitguardian.md)' 'is not installed (see .claude/integrations/gitguardian.md)')"; fi
  fi
  command -v jq >/dev/null 2>&1 || { say "Итог: без jq проверка невозможна" "Result: nothing can be checked without jq"; return 1; }

  section "$(t 'Настройка' 'Setup')"
  local owner_name owner_email
  owner_name="$(conf '.owner.name')"; owner_email="$(conf '.owner.email')"
  if [ -n "$owner_name" ] && [ -n "$owner_email" ]; then
    ok "$(t 'владелец' 'owner'): $owner_name <$owner_email>"
    apply_identity
    case $? in
      0) ok "$(t 'автор коммитов закреплён' 'commit author is pinned')" ;;
      2) warn "$(t 'автор коммитов только что записан в .claude/settings.local.json — он начнёт действовать в новой сессии' 'commit author was just written to .claude/settings.local.json — it takes effect in a new session')" ;;
      *) fail "$(t 'не удалось записать автора в .claude/settings.local.json' 'could not write the author to .claude/settings.local.json')" ;;
    esac
  else
    fail "$(t 'harness не настроен: bin/harness init' 'harness is not set up: bin/harness init')"
  fi
  if [ ! -d "$I18N/$HLANG" ]; then
    fail "$(t "нет комплекта i18n/$HLANG" "language set i18n/$HLANG is missing")"
  elif lang_stale "$HLANG"; then
    warn "$(t "правила в .claude/ не совпадают с i18n/$HLANG: bin/harness lang" "rules in .claude/ differ from i18n/$HLANG: bin/harness lang")"
  else
    ok "$(t "язык: $HLANG, правила развёрнуты" "language: $HLANG, rules are deployed")"
  fi
  while IFS= read -r v; do
    [ -z "$v" ] || fail "$(t "$v — нет пары на втором языке" "$v — has no counterpart in the other language")"
  done <<< "$(i18n_mismatch)"

  section "$(t 'Интеграции (только наличие токенов, значения не читаются)' 'Integrations (token presence only, values are not read)')"
  local any=0
  if integration_on plane; then any=1
    if [ -n "${PLANE_TOKEN:-}" ]; then ok "PLANE_TOKEN"; else warn "PLANE_TOKEN $(t 'не задан в окружении' 'is not set in the environment')"; fi
    [ -n "$(conf '.integrations.plane.url')" ] || fail "$(t 'в harness.json нет integrations.plane.url' 'harness.json has no integrations.plane.url')"
  fi
  if integration_on n8n; then any=1
    if [ -n "${N8N_TOKEN:-}" ]; then ok "N8N_TOKEN"; else warn "N8N_TOKEN $(t 'не задан в окружении' 'is not set in the environment')"; fi
    [ -n "$(conf '.integrations.n8n.url')" ] || fail "$(t 'в harness.json нет integrations.n8n.url' 'harness.json has no integrations.n8n.url')"
  fi
  if integration_on gitguardian; then any=1
    if [ -n "${GITGUARDIAN_TOKEN:-}" ]; then ok "GITGUARDIAN_TOKEN"; else warn "GITGUARDIAN_TOKEN $(t 'не задан в окружении' 'is not set in the environment')"; fi
  fi
  if integration_on mailcow; then any=1
    if [ -n "${MAILCOW_TOKEN:-}" ]; then ok "MAILCOW_TOKEN"; else warn "MAILCOW_TOKEN $(t 'не задан в окружении' 'is not set in the environment')"; fi
    [ -n "$(conf '.integrations.mailcow.url')" ] || fail "$(t 'в harness.json нет integrations.mailcow.url' 'harness.json has no integrations.mailcow.url')"
  fi
  if integration_on gitlab; then any=1
    if [ -n "${GITLAB_TOKEN:-}" ]; then ok "GITLAB_TOKEN"; else warn "GITLAB_TOKEN $(t 'не задан в окружении' 'is not set in the environment')"; fi
    [ -n "$(conf '.integrations.gitlab.url')" ] || fail "$(t 'в harness.json нет integrations.gitlab.url' 'harness.json has no integrations.gitlab.url')"
  fi
  if integration_on timeweb; then any=1
    if [ -n "${TW_TOKEN:-}" ]; then ok "TW_TOKEN"; else warn "TW_TOKEN $(t 'не задан в окружении' 'is not set in the environment')"; fi
  fi
  if integration_on yandex_cloud && command -v yc >/dev/null 2>&1; then any=1
    if yc config profile list 2>/dev/null | grep -q ' ACTIVE$'; then ok "$(t 'профиль yc' 'yc profile')"; else warn "$(t 'нет активного профиля yc (вход: yc init)' 'no active yc profile (log in: yc init)')"; fi
  fi
  [ "$any" -eq 1 ] || ok "$(t 'не подключены (ключ integrations в harness.json)' 'none enabled (the integrations key in harness.json)')"

  if [ -n "$(conf '.secrets.provider')" ]; then
    section "$(t 'Хранилище секретов (только имена, значения не читаются)' 'Secret store (names only, values are not read)')"
    if ! command -v bw >/dev/null 2>&1; then
      warn "$(t 'bw не установлен: brew install bitwarden-cli (см. .claude/integrations/bitwarden.md)' 'bw is not installed: brew install bitwarden-cli (see .claude/integrations/bitwarden.md)')"
    else
      local bst bsrv bwant v absent=""
      bst="$(bw_status | sed -n 1p)"; bsrv="$(bw_status | sed -n 2p)"; bwant="$(conf '.secrets.server')"
      if [ -n "$bwant" ] && [ "${bsrv%/}" != "${bwant%/}" ]; then
        warn "$(t "bw настроен на ${bsrv:-облако Bitwarden}, а нужно $bwant: bw config server $bwant" "bw points to ${bsrv:-the Bitwarden cloud}, expected $bwant: bw config server $bwant")"
      fi
      case "$bst" in
        unlocked) ok "$(t 'bw: вход выполнен, хранилище разблокировано' 'bw: logged in, the vault is unlocked')" ;;
        locked)   ok "$(t 'bw: вход выполнен, хранилище заблокировано' 'bw: logged in, the vault is locked')" ;;
        *)        warn "$(t 'bw: вход не выполнен — bw login' 'bw: not logged in — bw login')" ;;
      esac
      for v in $(secret_vars); do [ -n "${!v:-}" ] || absent="$absent $v"; done
      [ -z "$absent" ] || warn "$(t "в окружении нет:$absent — владелец приносит токены в сессию: eval \"\$(bin/harness secrets)\" перед claude" "missing from the environment:$absent — the owner brings tokens into the session: eval \"\$(bin/harness secrets)\" before claude")"
    fi
  fi

  section "Git"
  if [ "$(git -C "$ROOT" config --local core.hooksPath 2>/dev/null)" = ".githooks" ]; then
    ok "$(t 'git-хуки harness включены (контроль версии)' 'harness git hooks are enabled (version control)')"
  else
    warn "$(t 'git-хуки harness не включены: bin/harness init' 'harness git hooks are not enabled: bin/harness init')"
  fi
  if command -v gh >/dev/null 2>&1; then
    if gh auth token >/dev/null 2>&1; then ok "$(t 'gh авторизован' 'gh is authenticated')"; else warn "$(t 'gh не авторизован: gh auth login' 'gh is not authenticated: gh auth login')"; fi
  fi

  if command -v docker >/dev/null 2>&1; then
    section "Docker"
    local dstate=0
    docker_state || dstate=$?
    if [ "$dstate" -eq 0 ]; then
      ok "$(t 'демон запущен' 'the daemon is running')"
      local left
      left="$(harness_classified | awk '$3 != "own" && $1 != "images"' | grep -c .)"
      if [ "$left" -gt 0 ]; then
        warn "$(t "ресурсы harness других сессий и без метки сессии ($left): bin/harness docker-check" "harness resources of other sessions and without a session label ($left): bin/harness docker-check")"
      fi
    elif [ "$dstate" -eq 2 ]; then
      warn "$(t "Docker не отвечает: команда docker не завершилась за ${HARNESS_DOCKER_TIMEOUT:-10} с — перезапусти Docker Desktop" "Docker does not respond: a docker command did not finish within ${HARNESS_DOCKER_TIMEOUT:-10} s — restart Docker Desktop")"
    else
      ok "$(t 'демон остановлен (запуск при необходимости: bin/harness docker-up)' 'the daemon is stopped (start it when needed: bin/harness docker-up)')"
    fi
  fi

  section "$(t 'Реестр' 'Registry')"
  ensure_data
  if ! jq -e '.repos | type == "array"' "$REGISTRY" >/dev/null 2>&1; then
    fail "$(t 'registry/repos.json повреждён' 'registry/repos.json is corrupted')"
  else
    local total missing=0 name
    total="$(jq '.repos | length' "$REGISTRY")"
    while IFS= read -r name; do
      [ -z "$name" ] || [ -d "$REPOS_DIR/$name/.git" ] || missing=$((missing + 1))
    done < <(jq -r '.repos[].name' "$REGISTRY")
    if [ "$missing" -gt 0 ]; then
      warn "$(t "не склонировано репозиториев: $missing из $total — bin/harness sync" "repositories not cloned: $missing of $total — bin/harness sync")"
    else
      ok "$(t "репозиториев в реестре: $total, все на месте" "repositories in the registry: $total, all cloned")"
    fi
    if jq -e '.servers | type == "array"' "$SERVERS" >/dev/null 2>&1; then
      ok "$(t 'серверов в реестре' 'servers in the registry'): $(jq '.servers | length' "$SERVERS")"
    else
      fail "$(t 'registry/servers.json повреждён' 'registry/servers.json is corrupted')"
    fi
    if jq -e '.services | type == "array"' "$SERVICES" >/dev/null 2>&1; then
      local broken
      broken="$(broken_links)"
      if [ -n "$broken" ]; then
        while IFS= read -r v; do fail "$(t 'связи' 'links'): $v"; done <<< "$broken"
      else
        ok "$(t "связей в реестре: $(jq '.services | length' "$SERVICES"), ссылки целы" "links in the registry: $(jq '.services | length' "$SERVICES"), references are intact")"
      fi
    else
      fail "$(t 'registry/services.json повреждён' 'registry/services.json is corrupted')"
    fi
  fi

  if [ "$deep" -eq 1 ]; then
    section "$(t 'Доступы (реальные запросы)' 'Access (real requests)')"
    if git -C "$ROOT" ls-remote --exit-code origin HEAD >/dev/null 2>&1; then
      ok "$(t 'origin harness доступен' 'harness origin is reachable')"
    else
      fail "$(t 'origin harness недоступен' 'harness origin is unreachable')"
    fi
    local url
    url="$(conf '.integrations.plane.url')"
    [ -n "$url" ] && [ -n "${PLANE_TOKEN:-}" ] && http_check "Plane" "${url%/}/api/v1/users/me/" "X-API-Key: $PLANE_TOKEN"
    url="$(conf '.integrations.n8n.url')"
    [ -n "$url" ] && [ -n "${N8N_TOKEN:-}" ] && http_check "n8n" "${url%/}/api/v1/workflows?limit=1" "X-N8N-API-KEY: $N8N_TOKEN"
    url="$(conf '.integrations.gitlab.url')"
    [ -n "$url" ] && [ -n "${GITLAB_TOKEN:-}" ] && http_check "GitLab" "${url%/}/api/v4/user" "PRIVATE-TOKEN: $GITLAB_TOKEN"
    url="$(conf '.integrations.mailcow.url')"
    [ -n "$url" ] && [ -n "${MAILCOW_TOKEN:-}" ] && http_check "mailcow" "${url%/}/api/v1/get/status/version" "X-API-Key: $MAILCOW_TOKEN"
    integration_on timeweb && [ -n "${TW_TOKEN:-}" ] && http_check "Timeweb Cloud" "https://api.timeweb.cloud/api/v1/account/status" "Authorization: Bearer $TW_TOKEN"
    integration_on gitguardian && [ -n "${GITGUARDIAN_TOKEN:-}" ] && http_check "GitGuardian" "https://api.gitguardian.com/v1/health" "Authorization: Token $GITGUARDIAN_TOKEN"
    if integration_on yandex_cloud && command -v yc >/dev/null 2>&1 && yc config profile list 2>/dev/null | grep -q ' ACTIVE$'; then
      if yc resource-manager cloud list --format json >/dev/null 2>&1; then
        ok "Yandex Cloud: $(t 'доступ есть' 'access works')"
      else
        fail "Yandex Cloud: $(t 'запрос не прошёл (yc resource-manager cloud list); вход устарел — yc init' 'the request failed (yc resource-manager cloud list); the login expired — yc init')"
      fi
    fi
    section "$(t 'Серверы (SSH)' 'Servers (SSH)')"
    check_servers ""
  fi

  if [ "$QUIET" -eq 0 ]; then
    say "Итог: ошибок $ERRORS, предупреждений $WARNINGS" "Result: errors $ERRORS, warnings $WARNINGS"
  fi
  [ "$ERRORS" -eq 0 ]
}

# --- repositories -------------------------------------------------------------

cmd_sync() {
  need_registry
  local only="${1:-}" name url branch dir rc=0
  mkdir -p "$REPOS_DIR"
  while IFS=$'\t' read -r name url branch; do
    [ -n "$name" ] || continue
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    dir="$REPOS_DIR/$name"
    if [ ! -d "$dir/.git" ]; then
      if git clone --quiet ${branch:+--branch "$branch"} "$url" "$dir"; then
        row "$(t 'клонирован' 'cloned')" "$name"
      else
        row "$(t 'ОШИБКА' 'ERROR')" "$name: $(t "не удалось клонировать $url" "could not clone $url")"; rc=1
      fi
      continue
    fi
    if ! git -C "$dir" fetch --quiet --prune origin; then
      row "$(t 'ОШИБКА' 'ERROR')" "$name: $(t 'fetch не прошёл' 'fetch failed')"; rc=1
      continue
    fi
    # Local work is never touched: only a clean tree is updated and only by fast-forward.
    if [ -n "$(git -C "$dir" status --porcelain)" ]; then
      row "$(t 'только fetch' 'fetch only')" "$name: $(t 'есть незакоммиченные изменения' 'there are uncommitted changes')"
    elif ! git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      row "$(t 'только fetch' 'fetch only')" "$name: $(t 'у текущей ветки нет upstream' 'the current branch has no upstream')"
    elif git -C "$dir" merge --quiet --ff-only '@{u}' >/dev/null 2>&1; then
      row "$(t 'обновлён' 'updated')" "$name ($(git -C "$dir" rev-parse --abbrev-ref HEAD))"
    else
      row "$(t 'только fetch' 'fetch only')" "$name: $(t 'ветка разошлась с upstream' 'the branch has diverged from upstream')"
    fi
  done < <(jq -r '.repos[] | [.name, .url, (.branch // "")] | @tsv' "$REGISTRY")
  return "$rc"
}

cmd_status() {
  need_registry
  local name dir branch dirty ahead behind
  [ "$(jq '.repos | length' "$REGISTRY")" -gt 0 ] || { say "  реестр репозиториев пуст" "  the repository registry is empty"; return 0; }
  {
    t "РЕПОЗИТОРИЙ${US}ВЕТКА${US}ИЗМЕНЕНО${US}ВПЕРЕДИ${US}ПОЗАДИ" "REPOSITORY${US}BRANCH${US}MODIFIED${US}AHEAD${US}BEHIND"; echo
    while IFS= read -r name; do
      dir="$REPOS_DIR/$name"
      if [ ! -d "$dir/.git" ]; then
        echo "$name${US}$(t 'не склонирован' 'not cloned')${US}-${US}-${US}-"
        continue
      fi
      branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
      dirty="$(git -C "$dir" status --porcelain | grep -c .)"
      ahead="$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo '?')"
      behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')"
      echo "$name${US}$branch${US}$dirty${US}$ahead${US}$behind"
    done < <(jq -r '.repos[].name' "$REGISTRY")
  } | print_table
}

# Unsaved work in a clone: "<modified files> <commits on no remote> <stashes>".
clone_work() {
  local dir="$1"
  echo "$(git -C "$dir" status --porcelain 2>/dev/null | grep -c .) $(git -C "$dir" log --oneline --branches --not --remotes 2>/dev/null | grep -c .) $(git -C "$dir" stash list 2>/dev/null | grep -c .)"
}

# delete_clone <name> <force 0|1> — removes repos/<name>; refuses when it holds unsaved work.
delete_clone() {
  local name="$1" force="$2" dir="$REPOS_DIR/$1" d=0 u=0 s=0
  valid_name "$name" || return 1
  [ -e "$dir" ] || return 0
  if [ "$force" -ne 1 ]; then
    if [ ! -d "$dir/.git" ]; then
      row "$(t 'оставлен' 'kept')" "$name: $(t 'каталог не является клоном git' 'the directory is not a git clone')"
      return 1
    fi
    read -r d u s <<< "$(clone_work "$dir")"
    if [ $((d + u + s)) -gt 0 ]; then
      row "$(t 'оставлен' 'kept')" "$name: $(t "изменённых файлов $d, неотправленных коммитов $u, stash $s" "modified files $d, unpushed commits $u, stashes $s")"
      return 1
    fi
  fi
  rm -rf "$dir" && row "$(t 'клон удалён' 'clone gone')" "$name"
}

cmd_repo_remove() {
  need_registry; need_services
  local name="" unlink=0 delclone=0 force=0 arg links backup
  for arg in "$@"; do
    case "$arg" in
      --unlink) unlink=1 ;;
      --delete-clone) delclone=1 ;;
      --force) force=1 ;;
      -*) err "неизвестный параметр: $arg" "unknown option: $arg"; return 1 ;;
      *) name="$arg" ;;
    esac
  done
  valid_name "$name" || { err "укажи имя репозитория: bin/harness repo-remove <имя>" "give a repository name: bin/harness repo-remove <name>"; return 1; }
  jq -e --arg n "$name" '.repos | any(.name == $n)' "$REGISTRY" >/dev/null || { err "в реестре нет репозитория «${name}»" "there is no repository \"$name\" in the registry"; return 1; }
  links="$(jq -r --arg n "$name" '[.services[] | select(.repo == $n) | .name] | join(", ")' "$SERVICES")"
  if [ -n "$links" ] && [ "$unlink" -ne 1 ]; then
    err "на репозиторий «${name}» ссылаются связи: $links. Удали их (service-remove) или повтори с --unlink." \
        "repository \"$name\" is referenced by links: $links. Remove them (service-remove) or repeat with --unlink."
    return 1
  fi
  backup="$(backup_registry)"
  if [ -n "$links" ]; then
    json_edit "$SERVICES" --arg n "$name" '.services |= map(select(.repo != $n))' || return 1
    row "$(t 'связи' 'links')" "$(t "удалены: $links" "removed: $links")"
  fi
  json_edit "$REGISTRY" --arg n "$name" '.repos |= map(select(.name != $n))' || return 1
  row "$(t 'реестр' 'registry')" "$(t "репозиторий «${name}» удалён" "repository \"$name\" removed")"
  if [ "$delclone" -eq 1 ]; then
    delete_clone "$name" "$force"
  elif [ -e "$REPOS_DIR/$name" ]; then
    row "$(t 'клон' 'clone')" "$(t "оставлен в repos/$name" "kept in repos/$name")"
  fi
  row "$(t 'копия' 'backup')" "$backup"
}

# --- servers ------------------------------------------------------------------

# Key-based login and a known host only: the probe asks nothing and accepts nothing by itself.
ssh_probe() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes -p "$3" "$2@$1" true </dev/null >/dev/null 2>&1
}

check_servers() {
  local only="$1" name host port user
  jq -e '.servers | type == "array"' "$SERVERS" >/dev/null 2>&1 || return 0
  while IFS=$'\t' read -r name host port user; do
    [ -n "$name" ] || continue
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    if ssh_probe "$host" "$user" "$port"; then
      ok "$name: SSH $user@$host:$port"
    else
      fail "$name: $(t "нет входа по SSH на $user@$host:$port (ключ, known_hosts или сеть)" "no SSH login to $user@$host:$port (key, known_hosts or network)")"
    fi
  done < <(jq -r '.servers[] | [.name, .host, (.port // 22 | tostring), .user] | @tsv' "$SERVERS")
}

cmd_servers() {
  need_servers
  [ "$(jq '.servers | length' "$SERVERS")" -gt 0 ] || { say "  реестр серверов пуст" "  the server registry is empty"; return 0; }
  {
    t "ИМЯ${US}ХОСТ${US}ПОРТ${US}ПОЛЬЗОВАТЕЛЬ${US}ОКРУЖЕНИЕ${US}ЛОКАЦИЯ${US}НАЗНАЧЕНИЕ" "NAME${US}HOST${US}PORT${US}USER${US}ENV${US}LOCATION${US}PURPOSE"; echo
    jq -r '.servers[] | [.name, .host, (.port // 22 | tostring), .user, (.env // "?"), (.location // "-"), (.description // "-")] | map(if . == "" then "-" else . end) | join("\u001f")' "$SERVERS"
  } | print_table
}

cmd_server_check() {
  need_servers
  check_servers "${1:-}"
  [ "$ERRORS" -eq 0 ]
}

cmd_server_remove() {
  need_servers; need_services
  local name="" unlink=0 arg links dropped backup
  for arg in "$@"; do
    case "$arg" in
      --unlink) unlink=1 ;;
      -*) err "неизвестный параметр: $arg" "unknown option: $arg"; return 1 ;;
      *) name="$arg" ;;
    esac
  done
  valid_name "$name" || { err "укажи имя сервера: bin/harness server-remove <имя>" "give a server name: bin/harness server-remove <name>"; return 1; }
  jq -e --arg n "$name" '.servers | any(.name == $n)' "$SERVERS" >/dev/null || { err "в реестре нет сервера «${name}»" "there is no server \"$name\" in the registry"; return 1; }
  links="$(jq -r --arg n "$name" '[.services[] | select(.servers | index($n)) | .name] | join(", ")' "$SERVICES")"
  if [ -n "$links" ] && [ "$unlink" -ne 1 ]; then
    err "на сервер «${name}» ссылаются связи: $links. Повтори с --unlink: сервер будет убран из них, а связь без серверов удалена." \
        "server \"$name\" is referenced by links: $links. Repeat with --unlink: the server is taken out of them, and a link left without servers is removed."
    return 1
  fi
  backup="$(backup_registry)"
  if [ -n "$links" ]; then
    dropped="$(jq -r --arg n "$name" '[.services[] | select(.servers == [$n]) | .name] | join(", ")' "$SERVICES")"
    json_edit "$SERVICES" --arg n "$name" '.services |= (map(.servers -= [$n]) | map(select(.servers | length > 0)))' || return 1
    row "$(t 'связи' 'links')" "$(t "сервер убран из: $links" "server taken out of: $links")"
    [ -z "$dropped" ] || row "$(t 'связи' 'links')" "$(t "удалены целиком (серверов не осталось): $dropped" "removed entirely (no servers left): $dropped")"
  fi
  json_edit "$SERVERS" --arg n "$name" '.servers |= map(select(.name != $n))' || return 1
  row "$(t 'реестр' 'registry')" "$(t "сервер «${name}» удалён" "server \"$name\" removed")"
  row "$(t 'копия' 'backup')" "$backup"
}

# --- links --------------------------------------------------------------------

# Links that point to a repository or a server missing from the registries.
broken_links() {
  jq -rn --slurpfile r "$REGISTRY" --slurpfile s "$SERVERS" --slurpfile v "$SERVICES" \
    --arg norepo "$(t 'в реестре нет репозитория' 'no such repository in the registry:')" \
    --arg nosrv "$(t 'в реестре нет сервера' 'no such server in the registry:')" '
    ($r[0].repos | map(.name)) as $repos
    | ($s[0].servers | map(.name)) as $servers
    | $v[0].services[]
    | . as $svc
    | (select(.repo as $x | $repos | index($x) | not) | "\(.name): \($norepo) \(.repo)"),
      (.servers[] | select(. as $x | $servers | index($x) | not) | "\($svc.name): \($nosrv) \(.)")
  ' 2>/dev/null
}

# No argument — all links; with an argument — by the name of a repository, a server or a service.
cmd_map() {
  need_services
  local out
  out="$(jq -r --arg q "${1:-}" '
    .services[]
    | select($q == "" or .repo == $q or .name == $q or (.servers | index($q)))
    | [.name, .scope, .repo, (.servers | join(", ")), .path, .deploy]
    | map(if . == null or . == "" then "-" else . end) | join("\u001f")
  ' "$SERVICES")"
  if [ -n "$out" ]; then
    printf '%s\n' "$(t "СЕРВИС${US}ТИП${US}РЕПОЗИТОРИЙ${US}СЕРВЕРЫ${US}ПУТЬ${US}ДОСТАВКА" "SERVICE${US}SCOPE${US}REPOSITORY${US}SERVERS${US}PATH${US}DEPLOY")" "$out" | print_table
  elif [ -n "${1:-}" ]; then
    say "  связей не найдено для «$1»" "  no links found for \"$1\""
  else
    say "  связей не найдено" "  no links found"
  fi
}

cmd_service_remove() {
  need_services
  local name="${1:-}" backup
  valid_name "$name" || { err "укажи имя связи: bin/harness service-remove <имя>" "give a link name: bin/harness service-remove <name>"; return 1; }
  jq -e --arg n "$name" '.services | any(.name == $n)' "$SERVICES" >/dev/null || { err "в реестре нет связи «${name}»" "there is no link \"$name\" in the registry"; return 1; }
  backup="$(backup_registry)"
  json_edit "$SERVICES" --arg n "$name" '.services |= map(select(.name != $n))' || return 1
  row "$(t 'реестр' 'registry')" "$(t "связь «${name}» удалена" "link \"$name\" removed")"
  row "$(t 'копия' 'backup')" "$backup"
}

# --- reset --------------------------------------------------------------------

cmd_reset() {
  need_registry; need_servers; need_services
  local yes=0 delclones=0 force=0 arg name dir d u s nrepos nservers nlinks backup kept=0
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
      --delete-clones) delclones=1 ;;
      --force) force=1 ;;
      *) err "неизвестный параметр: $arg" "unknown option: $arg"; return 1 ;;
    esac
  done
  nrepos="$(jq '.repos | length' "$REGISTRY")"
  nservers="$(jq '.servers | length' "$SERVERS")"
  nlinks="$(jq '.services | length' "$SERVICES")"

  say "Сброс реестра harness. Будет удалено:" "Resetting the harness registry. To be removed:"
  row "$(t 'репозитории' 'repositories')" "$nrepos"
  row "$(t 'серверы' 'servers')" "$nservers"
  row "$(t 'связи' 'links')" "$nlinks"
  if [ "$nrepos" -gt 0 ]; then
    echo
    say "Клоны в repos/:" "Clones in repos/:"
    {
      t "РЕПОЗИТОРИЙ${US}КЛОН${US}ИЗМЕНЕНО${US}НЕОТПРАВЛЕНО${US}STASH" "REPOSITORY${US}CLONE${US}MODIFIED${US}UNPUSHED${US}STASH"; echo
      while IFS= read -r name; do
        dir="$REPOS_DIR/$name"
        if [ -d "$dir/.git" ]; then
          read -r d u s <<< "$(clone_work "$dir")"
          echo "$name${US}$(t 'есть' 'yes')${US}$d${US}$u${US}$s"
        else
          echo "$name${US}$(t 'нет' 'no')${US}-${US}-${US}-"
        fi
      done < <(jq -r '.repos[].name' "$REGISTRY")
    } | print_table
    echo
    if [ "$delclones" -eq 1 ] && [ "$force" -eq 1 ]; then
      say "Клоны будут удалены ВСЕ, включая те, где есть несохранённая работа (--force)." "ALL clones will be deleted, including those with unsaved work (--force)."
    elif [ "$delclones" -eq 1 ]; then
      say "Клоны без несохранённой работы будут удалены; остальные останутся на диске." "Clones without unsaved work will be deleted; the rest stay on disk."
    else
      say "Клоны останутся на диске (чтобы удалить и их — --delete-clones)." "Clones stay on disk (add --delete-clones to delete them too)."
    fi
  fi
  say "Останутся: harness.json (владелец, язык, интеграции), правила и skills. Серверы и удалённые репозитории не затрагиваются." \
      "Kept: harness.json (owner, language, integrations), rules and skills. Servers and remote repositories are not touched."

  if [ "$yes" -ne 1 ]; then
    echo
    say "Ничего не изменено. Чтобы выполнить сброс, повтори команду с --yes." "Nothing was changed. To perform the reset, repeat the command with --yes."
    return 0
  fi

  echo
  backup="$(backup_registry)"
  if [ "$delclones" -eq 1 ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      delete_clone "$name" "$force" || kept=$((kept + 1))
    done < <(jq -r '.repos[].name' "$REGISTRY")
  fi
  echo '{"repos": []}' > "$REGISTRY"
  echo '{"servers": []}' > "$SERVERS"
  echo '{"services": []}' > "$SERVICES"
  row "$(t 'реестр' 'registry')" "$(t "очищен: репозиториев $nrepos → 0, серверов $nservers → 0, связей $nlinks → 0" "emptied: repositories $nrepos → 0, servers $nservers → 0, links $nlinks → 0")"
  [ "$kept" -eq 0 ] || row "$(t 'клоны' 'clones')" "$(t "оставлено на диске: $kept" "kept on disk: $kept")"
  row "$(t 'копия' 'backup')" "$backup"
}

# --- commits ------------------------------------------------------------------

# Checks the commits that are not in upstream yet: author, committer, AI attribution.
cmd_check_commits() {
  need_jq
  local dir="${1:-.}" name email range bad=0 sha an ae cn ce
  name="$(conf '.owner.name')"; email="$(conf '.owner.email')"
  if [ -z "$name" ] || [ -z "$email" ]; then
    err "владелец не задан: bin/harness init" "the owner is not configured: bin/harness init"; return 1
  fi
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || { err "$dir — не git-репозиторий" "$dir is not a git repository"; return 1; }
  if git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    range='@{u}..HEAD'
  elif git -C "$dir" rev-parse --verify --quiet refs/remotes/origin/HEAD >/dev/null; then
    range='refs/remotes/origin/HEAD..HEAD'
  else
    range='HEAD'
  fi
  while IFS=$'\t' read -r sha an ae cn ce; do
    [ -n "$sha" ] || continue
    if [ "$an" != "$name" ] || [ "$ae" != "$email" ] || [ "$cn" != "$name" ] || [ "$ce" != "$email" ]; then
      echo "  FAIL  $sha: $(t "автор/коммиттер $an <$ae> / $cn <$ce>, ожидался $name <$email>" "author/committer $an <$ae> / $cn <$ce>, expected $name <$email>")"; bad=1
    fi
    if git -C "$dir" log -1 --format=%B "$sha" | grep -Eiq "$AI_MARKERS"; then
      echo "  FAIL  $sha: $(t 'в сообщении есть AI-атрибуция' 'the message contains AI attribution')"; bad=1
    fi
  done < <(git -C "$dir" log --format='%h%x09%an%x09%ae%x09%cn%x09%ce' "$range")
  [ "$bad" -eq 0 ] && echo "  ok    $(t "коммиты в порядке ($(git -C "$dir" rev-list --count "$range") шт.)" "commits are fine ($(git -C "$dir" rev-list --count "$range"))")"
  return "$bad"
}

# --- docker -------------------------------------------------------------------

cmd_docker_up() {
  local st=0
  docker_state || st=$?
  [ "$st" -eq 0 ] && { say "демон Docker уже запущен" "the Docker daemon is already running"; return 0; }
  [ "$st" -eq 2 ] && { docker_hung_msg; return 1; }
  case "$(uname -s)" in
    Darwin) open -ga Docker ;;
    Linux)  systemctl --user start docker-desktop 2>/dev/null || sudo -n systemctl start docker ;;
    *)      err "не знаю, как запустить Docker на этой ОС" "do not know how to start Docker on this OS"; return 1 ;;
  esac
  local i=0
  while [ "$i" -lt 60 ]; do
    dk -t 10 info >/dev/null && { say "демон Docker запущен" "the Docker daemon is running"; return 0; }
    sleep 2; i=$((i + 1))
  done
  err "демон Docker не поднялся за 120 секунд" "the Docker daemon did not start within 120 seconds"
  return 1
}

cmd_docker_check() {
  local st=0
  docker_state || st=$?
  [ "$st" -eq 2 ] && { docker_hung_msg; return 1; }
  [ "$st" -eq 0 ] || { say "демон Docker остановлен — ресурсов нет" "the Docker daemon is stopped — no resources"; return 0; }
  local list me c n v i other none
  list="$(harness_classified)"; me="$(harness_session)"
  count() { printf '%s\n' "$list" | awk -v k="$1" -v o="$2" '($1 == k || k == "*") && $3 == o' | grep -c .; }
  c="$(count containers own)"; n="$(count networks own)"; v="$(count volumes own)"; i="$(count images own)"
  other="$(count '*' other)"; none="$(count '*' none)"
  if [ -n "$me" ]; then
    say "ресурсы harness этой сессии ($me): контейнеров $c, сетей $n, томов $v, образов $i" \
        "harness resources of this session ($me): containers $c, networks $n, volumes $v, images $i"
  else
    say "сессия не определена (нет HARNESS_SESSION): своих ресурсов не выделить" \
        "the session is unknown (no HARNESS_SESSION): own resources cannot be told apart"
  fi
  [ "$other" -eq 0 ] || say "  других сессий: $other — их не трогаю" "  other sessions: $other — left alone"
  [ "$none" -eq 0 ] || say "  без метки сессии: $none — остановленные убирает docker-clean, работающие — docker-clean --all по слову владельца" \
                           "  without a session label: $none — docker-clean removes the stopped ones, the running ones — docker-clean --all on the owner's word"
  [ $((c + n + v + i)) -eq 0 ]
}

# docker-clean [--all] — by default this session's resources and the stopped ones without a session label;
# resources of other sessions stay. --all — every harness resource, only on the owner's word.
cmd_docker_clean() {
  local all=0 arg
  for arg in "$@"; do
    case "$arg" in
      --all) all=1 ;;
      *) err "неизвестный ключ: $arg" "unknown option: $arg"; return 1 ;;
    esac
  done
  local st=0
  docker_state || st=$?
  [ "$st" -eq 2 ] && { docker_hung_msg; return 1; }
  [ "$st" -eq 0 ] || { say "демон Docker остановлен — убирать нечего" "the Docker daemon is stopped — nothing to clean"; return 0; }
  local list k ids
  list="$(harness_classified)"
  pick() { printf '%s\n' "$list" | awk -v k="$k" -v all="$all" -v w="$1" '
    $1 != k { next }
    w == "own"  { if (all || $3 == "own") print $2; next }
    w == "none" { if (!all && $3 == "none" && (k != "containers" || $4 ~ /^(exited|created|dead)$/)) print $2 }'; }
  # Own resources go with force. Ones without a session go without it: docker refuses a network, volume or image
  # still in use, and only stopped containers are picked. Containers first: they hold networks and volumes.
  # shellcheck disable=SC2086  # ids are separate words on purpose
  for k in containers networks volumes images; do
    ids="$(pick own)"
    if [ -n "$ids" ]; then
      case "$k" in
        containers) dk -t 120 rm -f -v $ids ;;
        networks)   dk -t 120 network rm $ids ;;
        volumes)    dk -t 120 volume rm -f $ids ;;
        images)     dk -t 120 rmi -f $ids ;;
      esac >/dev/null
    fi
    ids="$(pick none)"
    if [ -n "$ids" ]; then
      case "$k" in
        containers) dk -t 120 rm -v $ids ;;
        networks)   dk -t 120 network rm $ids ;;
        volumes)    dk -t 120 volume rm $ids ;;
        images)     dk -t 120 rmi $ids ;;
      esac >/dev/null
    fi
  done
  cmd_docker_check
}

# --- selfcheck ----------------------------------------------------------------

# Integrity of harness itself: what CI and the release build rely on.
cmd_selfcheck() {
  need_jq
  local v f name cyr
  v="$(local_version)"
  section "$(t 'Версия' 'Version')"
  if printf '%s' "$v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then ok "VERSION $v"; else fail "$(t "VERSION должен быть вида X.Y.Z, сейчас «${v}»" "VERSION must look like X.Y.Z, now \"$v\"")"; fi
  for f in CHANGELOG.md CHANGELOG.en.md; do
    if grep -Fq "## [$v]" "$ROOT/$f" 2>/dev/null; then ok "$f: [$v]"; else fail "$(t "в $f нет записи «## [$v]»" "$f has no \"## [$v]\" entry")"; fi
  done

  section "$(t 'Языковые комплекты' 'Language sets')"
  local mism
  mism="$(i18n_mismatch)"
  if [ -n "$mism" ]; then
    while IFS= read -r f; do fail "$(t "$f — нет пары на втором языке" "$f — has no counterpart in the other language")"; done <<< "$mism"
  else
    ok "$(t "ru и en совпадают по составу: $(lang_files ru | grep -c .) файлов" "ru and en hold the same files: $(lang_files ru | grep -c .)")"
  fi
  for f in "$I18N"/*/skills/*/SKILL.md; do
    [ -f "$f" ] || continue
    name="$(sed -n 's/^name: *//p' "$f" | head -1)"
    [ "$name" = "$(basename "$(dirname "$f")")" ] || fail "$(t "${f#"$ROOT"/}: name «${name}» не совпадает с именем каталога" "${f#"$ROOT"/}: name \"$name\" differs from the directory name")"
    grep -q '^description: .' "$f" || fail "$(t "${f#"$ROOT"/}: нет description" "${f#"$ROOT"/}: description is missing")"
  done
  # Cyrillic is matched by its UTF-8 lead bytes: a character range depends on the locale.
  cyr="$(printf '[\320\321][\200-\277]')"
  if LC_ALL=C grep -rlq "$cyr" "$I18N/en" 2>/dev/null; then
    fail "$(t 'в i18n/en есть кириллица' 'i18n/en contains Cyrillic'): $(LC_ALL=C grep -rl "$cyr" "$I18N/en" | sed "s|^$ROOT/||" | tr '\n' ' ')"
  fi

  section "$(t 'Ядро без данных владельца' 'Core without owner data')"
  if jq -e . "$SETTINGS" >/dev/null 2>&1; then
    if jq -e '(.env // {}) | keys | map(select(test("^GIT_(AUTHOR|COMMITTER)_"))) | length == 0' "$SETTINGS" >/dev/null; then
      ok "$(t '.claude/settings.json не содержит автора коммитов' '.claude/settings.json holds no commit author')"
    else
      fail "$(t 'в .claude/settings.json записан автор коммитов — его место в harness.json' '.claude/settings.json holds a commit author — it belongs in harness.json')"
    fi
  else
    fail "$(t '.claude/settings.json отсутствует или повреждён' '.claude/settings.json is missing or corrupted')"
  fi
  for f in bin/harness install.sh; do
    if bash -n "$ROOT/$f" 2>/dev/null; then ok "bash -n $f"; else fail "bash -n $f"; fi
  done

  section "$(t 'Блокировки клонов' 'Clone locks')"
  selfcheck_locks
  selfcheck_worktree

  section "$(t 'Тексты запросов и релизов' 'Texts of requests and releases')"
  selfcheck_texts

  section "Docker"
  selfcheck_docker_hang

  section "$(t 'Секреты' 'Secrets')"
  selfcheck_secrets
  selfcheck_docker_clean

  say "Итог: ошибок $ERRORS" "Result: errors $ERRORS"
  [ "$ERRORS" -eq 0 ]
}

# A fake bw with a folder of two tokens: secrets prints export lines that eval back to the values, reports a
# missing item, and the Bash guard refuses to hand values to the agent.
selfcheck_secrets() {
  local tmp out rc
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/harness-secrets.XXXXXX")" || { fail "mktemp"; return; }
  printf '%s\n' '{"integrations":{"plane":{"url":"https://p.invalid"},"gitlab":{"url":"https://g.invalid"}},' \
    '"secrets":{"provider":"bitwarden","server":"https://key.invalid","folder":"harness","extra":["EXTRA_TOKEN"]}}' > "$tmp/h.json"
  cat > "$tmp/bw" <<'BW'
#!/bin/sh
case "$1 $2" in
  "status "*) echo '{"status":"unlocked","serverUrl":"https://key.invalid"}' ;;
  "sync "*) exit 0 ;;
  "list folders") echo '[{"id":"f1","name":"harness"}]' ;;
  "list items") echo '[{"name":"PLANE_TOKEN","login":{"password":"p a$s'"'"'1"}},{"name":"GITLAB_TOKEN","notes":"g-2"},{"name":"OTHER","login":{"password":"x"}}]' ;;
  *) exit 1 ;;
esac
BW
  chmod +x "$tmp/bw"
  out="$(PATH="$tmp:$PATH" HARNESS_CONF="$tmp/h.json" "$ROOT/bin/harness" secrets 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 1 ] && ( eval "$out"; [ "$PLANE_TOKEN" = "p a\$s'1" ] && [ "$GITLAB_TOKEN" = g-2 ] ) \
     && ! printf '%s' "$out" | grep -q OTHER; then
    ok "$(t 'secrets выдаёт export только нужных токенов, значения переживают eval, нехватка — код 1' 'secrets prints export lines only for the needed tokens, values survive eval, a missing one gives code 1')"
  else
    fail "$(t "secrets: код $rc, вывод не тот" "secrets: code $rc, wrong output")"
  fi
  sc_guard() {
    jq -n --arg d "$tmp" --arg c "$3" '{session_id: "T", cwd: $d, tool_input: {command: $c}}' \
      | HARNESS_STATE_DIR="$tmp/state" "$ROOT/bin/harness" hook guard-bash >/dev/null 2>&1
    rc=$?
    if [ "$rc" -eq "$1" ]; then ok "$2"; else fail "$2 ($(t "код $rc вместо $1" "code $rc instead of $1"))"; fi
  }
  sc_guard 2 "$(t 'агенту не выдаются значения: bin/harness secrets' 'values are refused to the agent: bin/harness secrets')" 'bin/harness secrets'
  sc_guard 2 "$(t 'агенту не выдаются значения: bw get password' 'values are refused to the agent: bw get password')" 'bw get password PLANE_TOKEN'
  sc_guard 0 "$(t 'проверка имён bin/harness secrets --check разрешена' 'the names check bin/harness secrets --check is allowed')" 'bin/harness secrets --check'
  sc_guard 0 "$(t 'слово secrets дальше в команде — не вызов' 'the word secrets further in a command is not a call')" 'git -C /x/harness log --grep secrets'
  sc_guard 2 "$(t 'вызов по полному пути отклонён' 'a call by full path is refused')" 'x=$(/opt/harness/bin/harness secrets)'
  unset -f sc_guard
  rm -rf "$tmp"
}

# A daemon that answers info but hangs on ps: docker-check reports it and returns instead of waiting.
selfcheck_docker_hang() {
  local tmp start rc out
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/harness-docker.XXXXXX")" || { fail "mktemp"; return; }
  printf '#!/bin/sh\ncase "$1" in info) exit 0 ;; *) exec sleep 30 ;; esac\n' > "$tmp/docker"
  chmod +x "$tmp/docker"
  start="$(date +%s)"
  out="$(PATH="$tmp:$PATH" HARNESS_DOCKER_TIMEOUT=1 "$ROOT/bin/harness" docker-check 2>&1)"; rc=$?
  if [ "$rc" -ne 0 ] && [ $(( $(date +%s) - start )) -lt 10 ] && printf '%s' "$out" | grep -q 'Docker'; then
    ok "$(t 'зависший docker ps не вешает harness: docker-check отвечает за секунды' 'a hanging docker ps does not hang harness: docker-check answers within seconds')"
  else
    fail "$(t "зависший docker ps: код $rc, $(( $(date +%s) - start )) с" "hanging docker ps: code $rc, $(( $(date +%s) - start )) s")"
  fi
  pkill -f "$tmp/docker" 2>/dev/null
  rm -rf "$tmp"
}

# docker-clean removes this session's resources and stopped ones without a session; another session's and running
# unlabelled containers stay. --all removes every harness resource and nothing else.
selfcheck_docker_clean() {
  local tmp got want
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/harness-docker.XXXXXX")" || { fail "mktemp"; return; }
  cat > "$tmp/docker" <<STUB
#!/bin/sh
case "\$1 \$2" in
  "info "*|"ps -q") exit 0 ;;
  "ps -a")        printf 'c1\t1\taaaaaaaa-1111\t\trunning\nc2\t1\tbbbbbbbb\t\trunning\nc3\t1\t\t\texited\nc4\t1\t\t\trunning\nc5\t\t\tharness-x-aaaaaaaa\trunning\nc6\t\t\tshop\trunning\n' ;;
  "network ls")   printf 'n1\t1\taaaaaaaa\t\t-\nn2\t\t\tharness-x-bbbbbbbb\t-\nn3\t1\t\t\t-\n' ;;
  "volume ls")    printf 'v1\t\t\tharness-x-aaaaaaaa\t-\nv2\t1\t\t\t-\n' ;;
  "images -q")    printf 'i1\ni2\ni3\n' ;;
  "image inspect") printf 'sha256:i1 aaaaaaaa\nsha256:i2 <no value>\nsha256:i3 bbbbbbbb\n' ;;
  *) echo "\$*" >> "$tmp/log" ;;
esac
STUB
  chmod +x "$tmp/docker"
  PATH="$tmp:$PATH" HARNESS_SESSION=aaaaaaaa "$ROOT/bin/harness" docker-clean >/dev/null 2>&1
  got="$(cat "$tmp/log" 2>/dev/null)"
  want="$(printf '%s\n' 'rm -f -v c1 c5' 'rm -v c3' 'network rm n1' 'network rm n3' 'volume rm -f v1' 'volume rm v2' 'rmi -f sha256:i1' 'rmi sha256:i2')"
  if [ "$got" = "$want" ]; then
    ok "$(t 'docker-clean убирает свою сессию и остановленное без метки, соседей и работающее без метки не трогает' 'docker-clean removes its own session and stopped unlabelled resources, leaves neighbours and running unlabelled ones')"
  else
    fail "$(t "docker-clean удалил не то: $(printf '%s' "$got" | tr '\n' ';')" "docker-clean removed the wrong set: $(printf '%s' "$got" | tr '\n' ';')")"
  fi
  rm -f "$tmp/log"
  PATH="$tmp:$PATH" HARNESS_SESSION=aaaaaaaa "$ROOT/bin/harness" docker-clean --all >/dev/null 2>&1
  got="$(cat "$tmp/log" 2>/dev/null)"
  want="$(printf '%s\n' 'rm -f -v c1 c2 c3 c4 c5' 'network rm n1 n2 n3' 'volume rm -f v1 v2' 'rmi -f sha256:i1 sha256:i2 sha256:i3')"
  if [ "$got" = "$want" ]; then
    ok "$(t 'docker-clean --all убирает все ресурсы harness и только их' 'docker-clean --all removes every harness resource and only them')"
  else
    fail "$(t "docker-clean --all удалил не то: $(printf '%s' "$got" | tr '\n' ';')" "docker-clean --all removed the wrong set: $(printf '%s' "$got" | tr '\n' ';')")"
  fi
  rm -rf "$tmp"
}

# The Bash guard reads the text files of gh and of the GitLab commands of harness and refuses AI attribution.
selfcheck_texts() {
  local tmp rc
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/harness-texts.XXXXXX")" || { fail "mktemp"; return; }
  printf 'Fixes the deploy.\n' > "$tmp/clean.md"
  # The marker is assembled here so that this file itself does not carry it.
  printf 'Fixes the deploy.\n\n%s %s Claude Code\n' Generated with > "$tmp/ai.md"
  # text_case <expected code> <label> <command>
  text_case() {
    jq -n --arg d "$tmp" --arg c "$3" '{session_id: "T", cwd: $d, tool_input: {command: $c}}' \
      | HARNESS_STATE_DIR="$tmp/state" "$ROOT/bin/harness" hook guard-bash >/dev/null 2>&1
    rc=$?
    if [ "$rc" -eq "$1" ]; then ok "$2"; else fail "$2 ($(t "код $rc вместо $1" "code $rc instead of $1"))"; fi
  }
  text_case 0 "$(t 'запрос в GitLab с чистым описанием проходит' 'a GitLab request with a clean text passes')" "bin/harness mr repos/x --title Fix --body-file $tmp/clean.md"
  text_case 2 "$(t 'AI-атрибуция в описании запроса в GitLab отклонена' 'AI attribution in a GitLab request text is refused')" "bin/harness mr repos/x --title Fix --body-file $tmp/ai.md"
  text_case 2 "$(t 'AI-атрибуция в описании релиза в GitLab отклонена' 'AI attribution in a GitLab release text is refused')" "bin/harness release-create repos/x v1.0.0 --title v1.0.0 --notes-file $tmp/ai.md"
  text_case 0 "$(t 'команда внутри подстановки читает файл без скобки' 'a command inside a substitution reads the file without the parenthesis')" "url=\$(bin/harness mr repos/x --title Fix --body-file $tmp/clean.md)"
  text_case 2 "$(t 'файл описания, которого нет, отклонён' 'a missing text file is refused')" "bin/harness mr repos/x --title Fix --body-file $tmp/none.md"
  text_case 2 "$(t 'AI-атрибуция в описании PR в GitHub отклонена' 'AI attribution in a GitHub PR text is refused')" "gh pr create --title Fix --body-file $tmp/ai.md"
  text_case 0 "$(t 'комментарий к задаче Plane с чистым текстом проходит' 'a Plane task comment with a clean text passes')" "bin/harness task comment X-1 --body-file $tmp/clean.md"
  text_case 2 "$(t 'AI-атрибуция в комментарии к задаче Plane отклонена' 'AI attribution in a Plane task comment is refused')" "bin/harness task comment X-1 --body-file $tmp/ai.md"
  printf '### Решение\n- a & `b`\n- **c**\n\nтекст\nещё\n' > "$tmp/md.md"
  if [ "$(pl_html "$tmp/md.md")" = '<h3>Решение</h3><ul><li>a &amp; <code>b</code></li><li><strong>c</strong></li></ul><p>текст<br>ещё</p>' ]; then
    ok "$(t 'Markdown для Plane превращается в HTML без пробелов между тегами' 'Markdown for Plane becomes HTML without whitespace between tags')"
  else
    fail "$(t 'Markdown для Plane: неверный HTML' 'Markdown for Plane: wrong HTML'): $(pl_html "$tmp/md.md")"
  fi
  unset -f text_case
  rm -rf "$tmp"
}

# Two sessions on throwaway clones: the second one is refused, a foreign branch survives.
selfcheck_locks() {
  local tmp r rc
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/harness-locks.XXXXXX")" || { fail "mktemp"; return; }
  r="$tmp/repos"
  mkdir -p "$r" "$tmp/state"
  for rc in alpha beta; do
    git init -q -b main "$r/$rc" 2>/dev/null && git -C "$r/$rc" -c user.name=selfcheck -c user.email=selfcheck@localhost commit -q --allow-empty -m init
  done
  # lock_case <expected code> <label> <session> <cwd> <command>
  lock_case() {
    jq -n --arg s "$3" --arg d "$4" --arg c "$5" '{session_id: $s, cwd: $d, tool_input: {command: $c}}' \
      | HARNESS_REPOS_DIR="$r" HARNESS_STATE_DIR="$tmp/state" "$ROOT/bin/harness" hook guard-bash >/dev/null 2>&1
    rc=$?
    if [ "$rc" -eq "$1" ]; then ok "$2"; else fail "$2 ($(t "код $rc вместо $1" "code $rc instead of $1"))"; fi
  }
  edit_case() {
    jq -n --arg s "$3" --arg f "$4" '{session_id: $s, tool_input: {file_path: $f}}' \
      | HARNESS_REPOS_DIR="$r" HARNESS_STATE_DIR="$tmp/state" "$ROOT/bin/harness" hook guard-edit >/dev/null 2>&1
    rc=$?
    if [ "$rc" -eq "$1" ]; then ok "$2"; else fail "$2 ($(t "код $rc вместо $1" "code $rc instead of $1"))"; fi
  }
  lock_case 0 "$(t 'сессия берёт свободный клон' 'a session takes a free clone')" A "$r" "git -C alpha switch -c feat-a"
  git -C "$r/alpha" switch -q -c feat-a
  lock_case 0 "$(t 'чтение чужого клона разрешено' 'reading a held clone is allowed')" B "$r" "git -C alpha log --oneline -1"
  lock_case 2 "$(t 'вторая сессия не уводит клон с чужой ветки' 'a second session cannot take the clone off a foreign branch')" B "$r" "git -C alpha switch main"
  lock_case 2 "$(t 'цикл по клонам тоже отклонён' 'a loop over clones is refused too')" B "$r" 'for x in alpha beta; do git -C $x switch -q main; done'
  lock_case 2 "$(t 'цикл с путём repos/$x из корня тоже отклонён' 'a loop with a repos/$x path from the root is refused too')" B "$tmp" 'for x in alpha beta; do git -C repos/$x switch -q main; done'
  edit_case 2 "$(t 'правка файла в чужом клоне отклонена' 'editing a file in a held clone is refused')" B "$r/alpha/file.txt"
  lock_case 0 "$(t 'хозяин клона продолжает работу' 'the holder goes on working')" A "$r/alpha" "git commit -m x"
  lock_case 2 "$(t 'чужую ветку удалить нельзя' 'a foreign branch cannot be deleted')" A "$r" "git -C alpha branch -D other"
  lock_case 2 "$(t 'удаление веток списком отклонено' 'deleting branches by a list is refused')" A "$r" "git -C alpha branch | xargs git -C alpha branch -D"
  lock_case 2 "$(t 'ветка с именем из переменной отклонена при создании' 'a branch named by a variable is refused on creation')" A "$r" 'git -C alpha switch -c "fix-$n"'
  lock_case 0 "$(t 'свою ветку удалить можно' 'the own branch can be deleted')" A "$r" "git -C alpha branch -D feat-a"
  git -C "$r/alpha" switch -q main
  lock_case 0 "$(t 'клон на основной ветке без правок свободен' 'a clean clone on its main branch is free')" B "$r" "git -C alpha switch -c feat-b"
  git -C "$r/beta" switch -q -c orphan
  lock_case 2 "$(t 'клон на ветке без хозяина нельзя увести с неё' 'a clone on a branch with no holder cannot be taken off it')" C "$r" "git -C beta stash"
  edit_case 0 "$(t 'в ветке без хозяина работу можно продолжить' 'work may go on in a branch with no holder')" D "$r/beta/file.txt"
  lock_case 0 "$(t 'команда в отдельной рабочей копии не блокируется' 'a command in a separate working copy is not blocked')" Z "$WORKTREES_DIR/alpha/x" "git commit -m y"
  unset -f lock_case edit_case
  rm -rf "$tmp"
}

selfcheck_worktree() {
  local tmp c g h
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/harness-wt.XXXXXX")" || { fail "mktemp"; return; }
  g=(git -c user.name=selfcheck -c user.email=selfcheck@localhost)
  git init -q --bare -b main "$tmp/origin.git"
  "${g[@]}" clone -q "$tmp/origin.git" "$tmp/seed" 2>/dev/null
  "${g[@]}" -C "$tmp/seed" commit -q --allow-empty -m init && git -C "$tmp/seed" push -q origin main
  mkdir -p "$tmp/repos" && git clone -q "$tmp/origin.git" "$tmp/repos/gamma"
  h=(env HARNESS_REPOS_DIR="$tmp/repos" HARNESS_WORKTREES_DIR="$tmp/wt" "$ROOT/bin/harness" worktree gamma)
  # wt_case <0 — the branch is deleted | 1 — it is kept> <label> <branch>
  wt_case() {
    "${h[@]}" "$3" --remove >/dev/null 2>&1
    if git -C "$tmp/repos/gamma" show-ref --verify --quiet "refs/heads/$3"; then c=1; else c=0; fi
    if [ "$c" -eq "$1" ]; then ok "$2"; else fail "$2"; fi
  }
  "${h[@]}" empty >/dev/null
  wt_case 0 "$(t '--remove удаляет ветку без коммитов' '--remove deletes a branch with no commits')" empty
  "${h[@]}" local >/dev/null && "${g[@]}" -C "$tmp/wt/gamma/local" commit -q --allow-empty -m wip
  wt_case 1 "$(t '--remove оставляет ветку с неотправленным коммитом' '--remove keeps a branch with an unpushed commit')" local
  "${h[@]}" pushed >/dev/null && "${g[@]}" -C "$tmp/wt/gamma/pushed" commit -q --allow-empty -m done && git -C "$tmp/wt/gamma/pushed" push -q origin pushed 2>/dev/null
  wt_case 0 "$(t '--remove удаляет отправленную ветку' '--remove deletes a pushed branch')" pushed
  "${h[@]}" squashed >/dev/null
  for c in a b; do echo "$c" > "$tmp/wt/gamma/squashed/$c.txt"; git -C "$tmp/wt/gamma/squashed" add "$c.txt"; "${g[@]}" -C "$tmp/wt/gamma/squashed" commit -q -m "$c"; done
  git -C "$tmp/seed" pull -q origin main 2>/dev/null; echo a > "$tmp/seed/a.txt"; echo b > "$tmp/seed/b.txt"
  git -C "$tmp/seed" add a.txt b.txt && "${g[@]}" -C "$tmp/seed" commit -q -m squash && git -C "$tmp/seed" push -q origin main
  wt_case 0 "$(t '--remove удаляет ветку, влитую squash-слиянием' '--remove deletes a branch merged by squash')" squashed
  unset -f wt_case
  rm -rf "$tmp"
}

# --- public release -----------------------------------------------------------

# Drops the <!-- private --> … <!-- /private --> blocks and the version sections left empty after that.
strip_private() {
  local file="$1" tmp
  [ -f "$file" ] || return 0
  tmp="$(mktemp "${TMPDIR:-/tmp}/harness.XXXXXX")" || return 1
  awk '
    function flush() { if (head != "") { if (keep) printf "%s%s", head, body; head = ""; body = ""; keep = 0 } }
    /<!-- private -->/  { skip = 1; next }
    /<!-- \/private -->/ { skip = 0; next }
    skip { next }
    /^## \[/ { flush(); head = $0 "\n"; next }
    head != "" { body = body $0 "\n"; if ($0 !~ /^[[:space:]]*$/) keep = 1; next }
    { print }
    END { flush() }
  ' "$file" | cat -s > "$tmp" && cat "$tmp" > "$file"
  rm -f "$tmp"
}

# leak_grep <dir> <label> <regex> <allowed regex> [grep flags] — every match outside the allowed ones is a failure.
leak_grep() {
  local dir="$1" label="$2" re="$3" allow="$4" flags="${5:-}" hits
  hits="$(cd "$dir" && grep -rnIE ${flags:+"$flags"} -e "$re" . --exclude-dir=.git 2>/dev/null | grep -vE "$allow" | head -20)"
  if [ -n "$hits" ]; then
    fail "$label:"
    while IFS= read -r re; do echo "          ${re:0:170}"; done <<< "$hits"
  else
    ok "$label"
  fi
}

# Terms that identify the owner: taken from harness.json and the registries of this install.
owner_terms() {
  [ -f "$CONF" ] || [ -d "$ROOT/registry" ] || return 0
  ensure_data
  {
    conf '.owner.email'
    conf '.owner.email' | sed 's/.*@//'
    conf '.owner.name' | tr ' ' '\n' | awk 'length($0) >= 3'
    conf '.integrations | .. | strings' | sed -E 's#^https?://##; s#/.*$##' | awk 'length($0) >= 5'
    conf '.release.deny[]?'
    jq -r '.repos[] | .url, .plane_project, .plane_project_id, (.name | select(length >= 5)) | select(. != null)' "$REGISTRY" 2>/dev/null
    jq -r '.repos[].url' "$REGISTRY" 2>/dev/null | sed -nE 's#^(git@|https://)[^:/]+[:/]([^/]+)/.*#\2#p'
    jq -r '.servers[] | .host, .provider, (.name | select(length >= 5)) | select(. != null)' "$SERVERS" 2>/dev/null
    jq -r '.services[] | (.name | select(length >= 5)), (.url // empty | sub("^https?://"; "") | sub("/.*$"; ""))' "$SERVICES" 2>/dev/null
  } | awk 'NF' | LC_ALL=C sort -u | grep -vxF -f <(conf '.release.allow_terms[]?'; echo "$US")
}

# Phrases in which the owner's name is legitimate: authorship and the public repository address.
owner_allowed() {
  conf '.owner.name'
  conf '.release.author_aliases[]?'
  conf '.release.public_repo' | sed -E 's#^(git@|https://)[^:/]+[:/]##; s#\.git$##'
}

# Scans a tree that is about to become public. Fails on anything that looks like owner data or a secret.
leak_check() {
  local dir="$1" p terms allowed line stripped phrase term found n=0
  section "$(t 'Проверка на утечки' 'Leak check'): ${dir#"$ROOT"/}"

  for p in harness.json registry repos dist .harness-backup .claude/settings.local.json .claude/CLAUDE.md .claude/rules .claude/skills; do
    [ ! -e "$dir/$p" ] || fail "$(t "в сборке есть $p — это данные установки, не ядро" "the build contains $p — install data, not the core")"
  done
  p="$(cd "$dir" && find . \( -name .DS_Store -o -name '.env' -o -name '.env.*' -o -name '*.pem' -o -name '*.key' -o -name 'id_rsa*' -o -name 'id_ed25519*' \) -not -path './.git/*' | head -5)"
  if [ -n "$p" ]; then fail "$(t 'лишние файлы' 'stray files'): $(echo "$p" | tr '\n' ' ')"; else ok "$(t 'нет файлов с данными установки и ключами' 'no install data or key files')"; fi

  leak_grep "$dir" "$(t 'адреса почты' 'email addresses')" \
    '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}' \
    'git@github\.com|@([A-Za-z0-9-]+\.)*example\.(com|org|net)|@users\.noreply\.github\.com|noreply@anthropic'
  leak_grep "$dir" "$(t 'IP-адреса' 'IP addresses')" \
    '(^|[^0-9.])((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])([^0-9.]|$)' \
    '127\.0\.0\.1|0\.0\.0\.0|192\.0\.2\.|198\.51\.100\.|203\.0\.113\.'
  leak_grep "$dir" "$(t 'идентификаторы UUID' 'UUID identifiers')" \
    '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' '^$' -i
  leak_grep "$dir" "$(t 'домашние каталоги' 'home directories')" \
    '/(Users|home)/[A-Za-z0-9._-]+' '/home/(user|runner)|/Users/(you|user)'
  leak_grep "$dir" "$(t 'ключи и токены' 'keys and tokens')" \
    'BEGIN [A-Z ]*PRIVATE KEY|(ghp|gho|ghs|ghu)_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|glpat-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|y[0-3]_[A-Za-z0-9_-]{30,}' '^$'

  terms="$(owner_terms)"
  if [ -n "$terms" ]; then
    allowed="$(owner_allowed)"
    found=""
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      stripped="$line"
      while IFS= read -r phrase; do
        [ -z "$phrase" ] || stripped="${stripped//"$phrase"/}"
      done <<< "$allowed"
      while IFS= read -r term; do
        if printf '%s' "${stripped#*:*:}" | grep -qiF -e "$term"; then
          found="$found${line%%:*}:$(printf '%s' "$line" | cut -d: -f2): «${term}»"$'\n'; n=$((n + 1))
          break
        fi
      done <<< "$terms"
      [ "$n" -lt 30 ] || break
    done < <(cd "$dir" && grep -rnIiF -f <(echo "$terms") . --exclude-dir=.git 2>/dev/null)
    if [ -n "$found" ]; then
      fail "$(t "данные владельца (слов в списке: $(echo "$terms" | grep -c .))" "owner data (terms in the list: $(echo "$terms" | grep -c .))"):"
      printf '%s' "$found" | sed 's/^/          /'
    else
      ok "$(t "данные владельца не найдены (слов в списке: $(echo "$terms" | grep -c .))" "no owner data found (terms in the list: $(echo "$terms" | grep -c .))")"
    fi
  else
    ok "$(t 'данных владельца в этой установке нет — проверены только общие признаки' 'this install holds no owner data — only the generic patterns were checked')"
  fi

  if integration_on gitguardian && command -v ggshield >/dev/null 2>&1 && [ -n "${GITGUARDIAN_TOKEN:-}" ]; then
    if GITGUARDIAN_API_KEY="$GITGUARDIAN_TOKEN" ggshield secret scan path -r -y "$dir" >/dev/null 2>&1; then
      ok "ggshield: $(t 'секретов нет' 'no secrets')"
    else
      fail "ggshield: $(t "найдены секреты или проверка не прошла — ggshield secret scan path -r ${dir#"$ROOT"/}" "secrets found or the scan failed — ggshield secret scan path -r ${dir#"$ROOT"/}")"
    fi
  fi
  [ "$ERRORS" -eq 0 ]
}

# Requirements for a real (non-preview) release: clean tree, version ≥ 1.0.0, tag v<version> on HEAD.
release_ready() {
  local v="$1"
  if [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then
    err "рабочее дерево не чистое: сначала закоммить изменения (или собери пробную версию: --preview)" \
        "the working tree is not clean: commit first (or build a trial version: --preview)"; return 1
  fi
  if ver_gt "1.0.0" "$v"; then
    err "публичные релизы начинаются с 1.0.0, сейчас $v" "public releases start at 1.0.0, now $v"; return 1
  fi
  if [ "$(git -C "$ROOT" rev-parse -q --verify "refs/tags/v$v^{commit}" 2>/dev/null)" != "$(git -C "$ROOT" rev-parse HEAD)" ]; then
    err "на текущем коммите нет тега v$v" "the current commit is not tagged v$v"; return 1
  fi
}

cmd_release_build() {
  need_jq
  local preview=0 v out f n
  [ "${1:-}" = "--preview" ] && preview=1
  v="$(local_version)"
  [ "$preview" -eq 1 ] || release_ready "$v" || return 1
  out="$DIST/harness-v$v"
  rm -rf "$out" "$DIST/harness-v$v.tar.gz" "$DIST/harness-v$v.tar.gz.sha256" "$DIST/harness-v$v.preview"
  mkdir -p "$out"

  if [ "$preview" -eq 1 ]; then
    # Trial build from the working tree: tracked files plus new ones that are not ignored.
    while IFS= read -r f; do
      [ -f "$ROOT/$f" ] || continue
      mkdir -p "$out/$(dirname "$f")" && cp -p "$ROOT/$f" "$out/$f"
    done < <(git -C "$ROOT" ls-files -co --exclude-standard)
    : > "$DIST/harness-v$v.preview"
  else
    git -C "$ROOT" archive HEAD | tar -x -C "$out" || return 1
  fi

  # The owner's data never leaves the private repository.
  rm -rf "$out/harness.json" "$out/registry" "$out/repos" "$out/dist" "$out/.harness-backup"
  strip_private "$out/CHANGELOG.md"
  strip_private "$out/CHANGELOG.en.md"
  if ! grep -qF "$IGNORE_MARK" "$out/.gitignore" 2>/dev/null; then
    printf '\n%s\n%s\n%s\n' "$IGNORE_MARK (created by bin/harness init, never committed here)" "/harness.json" "/registry/" >> "$out/.gitignore"
  fi

  n="$(find "$out" -type f | grep -c .)"
  section "$(t "Сборка harness v$v: файлов $n" "Build of harness v$v: $n files")$([ "$preview" -eq 0 ] || t ' (пробная, из рабочего дерева)' ' (trial, from the working tree)')"
  for f in LICENSE README.md README.en.md install.sh bin/harness VERSION CHANGELOG.md CHANGELOG.en.md .claude/settings.json; do
    [ -f "$out/$f" ] || fail "$(t "в сборке нет $f" "the build lacks $f")"
  done
  grep -Fq "## [$v]" "$out/CHANGELOG.md" || fail "$(t "в публичном CHANGELOG.md нет записи [$v] — она целиком закрытая?" "the public CHANGELOG.md has no [$v] entry — is it entirely private?")"
  leak_check "$out"

  if [ "$ERRORS" -gt 0 ]; then
    echo
    err "Сборка НЕ готова к публикации: ошибок $ERRORS. Исправь источник в ядре и собери заново." \
        "The build is NOT fit for publishing: errors $ERRORS. Fix the source in the core and build again."
    return 1
  fi
  tar -czf "$DIST/harness-v$v.tar.gz" -C "$DIST" "harness-v$v"
  (cd "$DIST" && shasum -a 256 "harness-v$v.tar.gz" > "harness-v$v.tar.gz.sha256")
  echo
  say "Готово: dist/harness-v$v/ и dist/harness-v$v.tar.gz" "Done: dist/harness-v$v/ and dist/harness-v$v.tar.gz"
  [ "$preview" -eq 0 ] || say "Это пробная сборка: опубликовать её нельзя. Для релиза — коммит, тег v$v и bin/harness release-build." \
                              "This is a trial build and cannot be published. For a release: commit, tag v$v, then bin/harness release-build."
}

# Section of a changelog for one version, without the heading.
changelog_section() {
  awk -v v="## [$2]" 'index($0, v) == 1 { on = 1; next } /^## \[/ { on = 0 } on' "$1" 2>/dev/null
}

cmd_release_publish() {
  need_jq
  local push=0 v out repo slug work notes
  [ "${1:-}" = "--push" ] && push=1
  v="$(local_version)"
  out="$DIST/harness-v$v"
  repo="$(conf '.release.public_repo')"
  [ -n "$repo" ] || { err "в harness.json не задан release.public_repo" "harness.json has no release.public_repo"; return 1; }
  release_ready "$v" || return 1
  if [ ! -d "$out" ] || [ -e "$DIST/harness-v$v.preview" ] || [ ! -f "$DIST/harness-v$v.tar.gz" ]; then
    err "нет готовой сборки v$v: сначала bin/harness release-build" "there is no finished build of v$v: run bin/harness release-build first"; return 1
  fi
  leak_check "$out" || { err "публикация остановлена: проверка на утечки не прошла" "publishing stopped: the leak check failed"; return 1; }

  slug="$(printf '%s' "$repo" | sed -E 's#^(git@|https://)[^:/]+[:/]##; s#\.git$##')"
  work="$DIST/public-repo"
  rm -rf "$work"
  git clone --quiet "$repo" "$work" 2>/dev/null || { err "не удалось клонировать $repo" "could not clone $repo"; return 1; }
  if git -C "$work" rev-parse -q --verify "refs/tags/v$v" >/dev/null; then
    err "тег v$v уже есть в публичном репозитории" "tag v$v already exists in the public repository"; return 1
  fi
  git -C "$work" symbolic-ref HEAD refs/heads/main
  find "$work" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
  cp -R "$out"/. "$work"/
  git -C "$work" add -A
  if git -C "$work" diff --cached --quiet; then
    say "публичный репозиторий уже совпадает со сборкой v$v — отправлять нечего" "the public repository already matches build v$v — nothing to push"; return 0
  fi
  echo
  say "Изменения в $slug:" "Changes in $slug:"
  git -C "$work" diff --cached --stat | tail -n 25
  if [ "$push" -ne 1 ]; then
    echo
    say "Ничего не отправлено. Чтобы опубликовать v$v, повтори с --push." "Nothing was pushed. To publish v$v, repeat with --push."
    return 0
  fi

  git -C "$work" commit --quiet -m "Release v$v" || return 1
  git -C "$work" tag -a "v$v" -m "harness v$v" || return 1
  git -C "$work" push --quiet origin HEAD:refs/heads/main "v$v" || { err "push в $slug не прошёл" "push to $slug failed"; return 1; }
  notes="$(mktemp "${TMPDIR:-/tmp}/harness.XXXXXX")"
  { changelog_section "$out/CHANGELOG.en.md" "$v"; printf '\n---\n\n'; changelog_section "$out/CHANGELOG.md" "$v"; } > "$notes"
  if command -v gh >/dev/null 2>&1; then
    gh release create "v$v" --repo "$slug" --verify-tag --title "v$v" --notes-file "$notes" \
      "$DIST/harness-v$v.tar.gz" "$DIST/harness-v$v.tar.gz.sha256" || err "тег отправлен, но релиз в GitHub создать не удалось" "the tag is pushed, but the GitHub release could not be created"
  fi
  rm -f "$notes"
  say "Опубликовано: $slug v$v" "Published: $slug v$v"
}

# --- GitLab -------------------------------------------------------------------

# forge_of <path> — where the clone's origin lives: gitlab (the host of integrations.gitlab.url), github or other.
forge_of() {
  local host gl
  host="$(git -C "$1" remote get-url origin 2>/dev/null | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#[:/].*##')"
  gl="$(conf '.integrations.gitlab.url' | sed -E 's#^[a-z]+://##; s#[:/].*##')"
  if [ -n "$gl" ] && [ "$host" = "$gl" ]; then echo gitlab
  elif [ "$host" = github.com ]; then echo github
  else echo other; fi
}

# gl_project <path> — namespace/project of the clone's origin, encoded for the API.
gl_project() {
  git -C "$1" remote get-url origin 2>/dev/null \
    | sed -E 's#^[a-z+]+://[^/]+/##; s#^[^@/]*@[^:]+:##; s#\.git$##' | jq -sRr 'rtrimstr("\n") | @uri'
}

# gl_api <api path> [curl args] — the token goes in a header and only to the GitLab of this installation.
gl_api() {
  local url; url="$(conf '.integrations.gitlab.url')"
  curl -sS --max-time 60 -H @<(printf 'PRIVATE-TOKEN: %s' "$GITLAB_TOKEN") -H 'Content-Type: application/json' \
    "${url%/}/api/v4$1" "${@:2}"
}

gl_ready() {
  integration_on gitlab || { err "интеграция gitlab не подключена: integrations.gitlab.url в harness.json" "the gitlab integration is not enabled: integrations.gitlab.url in harness.json"; return 1; }
  [ -n "${GITLAB_TOKEN:-}" ] || { err "GITLAB_TOKEN не задан в окружении" "GITLAB_TOKEN is not set in the environment"; return 1; }
  [ "$(forge_of "$1")" = gitlab ] || { err "origin репозитория $1 — не GitLab этой установки" "the origin of $1 is not the GitLab of this installation"; return 1; }
}

# no_ai_text <text> <file> — the title and the file carry no AI attribution; the file must exist.
no_ai_text() {
  [ -f "$2" ] || { err "нет файла $2" "no file $2"; return 1; }
  if printf '%s' "$1" | grep -Eiq "$AI_MARKERS" || grep -Eiq "$AI_MARKERS" "$2"; then
    err "в заголовке или в $2 есть AI-атрибуция (см. .claude/rules/git.md)" "the title or $2 contains AI attribution (see .claude/rules/git.md)"; return 1
  fi
}

gl_fail() {
  err "GitLab: $(printf '%s' "$1" | jq -rc '.message // .error // .' 2>/dev/null | cut -c1-300)" "GitLab: $(printf '%s' "$1" | jq -rc '.message // .error // .' 2>/dev/null | cut -c1-300)"
  return 1
}

cmd_forge() { forge_of "${1:-.}"; }

# mr <path> --title <title> --body-file <file> [--base <branch>] — a merge request from the current branch.
cmd_mr() {
  local path="${1:-}" title="" body="" base="" branch res
  [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title="${2:-}"; shift 2 ;;
      --body-file) body="${2:-}"; shift 2 ;;
      --base) base="${2:-}"; shift 2 ;;
      *) err "неизвестный ключ: $1" "unknown option: $1"; return 1 ;;
    esac
  done
  if [ -z "$path" ] || [ -z "$title" ] || [ -z "$body" ]; then
    err "использование: bin/harness mr <путь> --title <заголовок> --body-file <файл> [--base <ветка>]" \
        "usage: bin/harness mr <path> --title <title> --body-file <file> [--base <branch>]"
    return 1
  fi
  gl_ready "$path" && no_ai_text "$title" "$body" || return 1
  branch="$(git -C "$path" branch --show-current)"
  [ -n "$base" ] || base="$(git -C "$path" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
  base="${base:-main}"
  if [ -z "$branch" ] || [ "$branch" = "$base" ]; then
    err "текущая ветка — основная или не выбрана: создай рабочую ветку" "the current branch is the base one or none: create a working branch"; return 1
  fi
  res="$(jq -n --arg s "$branch" --arg t "$base" --arg ti "$title" --rawfile d "$body" \
    '{source_branch: $s, target_branch: $t, title: $ti, description: $d, remove_source_branch: true}' \
    | gl_api "/projects/$(gl_project "$path")/merge_requests" -X POST -d @-)"
  printf '%s' "$res" | jq -e '.web_url' >/dev/null 2>&1 || { gl_fail "$res"; return 1; }
  printf '%s' "$res" | jq -r '.web_url'
}

# mr-status <path> <number> — the pipeline of the request and whether it can be merged.
cmd_mr_status() {
  local path="${1:-}" iid="${2:-}" res
  [ -n "$path" ] && [ -n "$iid" ] || { err "использование: bin/harness mr-status <путь> <номер>" "usage: bin/harness mr-status <path> <number>"; return 1; }
  gl_ready "$path" || return 1
  res="$(gl_api "/projects/$(gl_project "$path")/merge_requests/$iid")"
  printf '%s' "$res" | jq -e '.iid' >/dev/null 2>&1 || { gl_fail "$res"; return 1; }
  printf '%s' "$res" | jq -r --arg l "$HLANG" 'if $l != "ru" then
      "!\(.iid) \(.state): pipeline \(.head_pipeline.status // "none"), merge \(.detailed_merge_status)"
    else
      "!\(.iid) \(.state): конвейер \(.head_pipeline.status // "нет"), слияние \(.detailed_merge_status)" end'
}

# release-create <path> <tag> --title <title> --notes-file <file> — a release for a tag already pushed.
cmd_release_create() {
  local path="${1:-}" tag="${2:-}" title="" notes="" res enc
  [ $# -gt 1 ] && shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title="${2:-}"; shift 2 ;;
      --notes-file) notes="${2:-}"; shift 2 ;;
      *) err "неизвестный ключ: $1" "unknown option: $1"; return 1 ;;
    esac
  done
  if [ -z "$path" ] || [ -z "$tag" ] || [ -z "$title" ] || [ -z "$notes" ]; then
    err "использование: bin/harness release-create <путь> <тег> --title <заголовок> --notes-file <файл>" \
        "usage: bin/harness release-create <path> <tag> --title <title> --notes-file <file>"
    return 1
  fi
  gl_ready "$path" && no_ai_text "$title" "$notes" || return 1
  enc="$(printf '%s' "$tag" | jq -sRr @uri)"
  gl_api "/projects/$(gl_project "$path")/repository/tags/$enc" | jq -e '.name' >/dev/null 2>&1 \
    || { err "тега $tag нет в GitLab: сначала отправь его" "tag $tag is not in GitLab: push it first"; return 1; }
  res="$(jq -n --arg t "$tag" --arg n "$title" --rawfile d "$notes" '{tag_name: $t, name: $n, description: $d}' \
    | gl_api "/projects/$(gl_project "$path")/releases" -X POST -d @-)"
  printf '%s' "$res" | jq -e '.tag_name' >/dev/null 2>&1 || { gl_fail "$res"; return 1; }
  printf '%s' "$res" | jq -r '._links.self'
}

# --- secrets ------------------------------------------------------------------

# Token variables of the enabled integrations, one per line, plus secrets.extra from harness.json.
secret_vars() {
  local i v
  for i in plane:PLANE_TOKEN n8n:N8N_TOKEN gitguardian:GITGUARDIAN_TOKEN mailcow:MAILCOW_TOKEN gitlab:GITLAB_TOKEN timeweb:TW_TOKEN; do
    integration_on "${i%%:*}" && echo "${i#*:}"
  done
  conf '.secrets.extra[]?' | while IFS= read -r v; do
    printf '%s' "$v" | grep -Eq '^[A-Z][A-Z0-9_]*$' && echo "$v"
  done
}

secrets_ready() {
  [ "$(conf '.secrets.provider')" = bitwarden ] || { err "хранилище секретов не настроено: secrets.provider в harness.json (см. .claude/integrations/bitwarden.md)" "no secret store is configured: secrets.provider in harness.json (see .claude/integrations/bitwarden.md)"; return 1; }
  command -v bw >/dev/null 2>&1 || { err "нужен Bitwarden CLI (bw): brew install bitwarden-cli" "Bitwarden CLI (bw) is required: brew install bitwarden-cli"; return 1; }
  need_jq
}

# bw_status — status of the CLI: unauthenticated, locked or unlocked; the server it is bound to on line 2.
bw_status() { bw status 2>/dev/null | jq -r '.status // "unknown", .serverUrl // ""'; }

# secrets [--check] — tokens of the enabled integrations from the folder secrets.folder of a Bitwarden (or compatible) vault.
# Without --check it prints «export NAME=value» lines for eval in the owner's shell, never to a terminal:
#   eval "$(bin/harness secrets)"
# --check prints only which names are present. Values never go anywhere else.
cmd_secrets() {
  local check=0 st server want folder fid items vars name val missing="" found=0
  case "${1:-}" in --check) check=1 ;; "") ;; *) err "использование: bin/harness secrets [--check]" "usage: bin/harness secrets [--check]"; return 1 ;; esac
  secrets_ready || return 1
  if [ "$check" -eq 0 ] && [ -t 1 ]; then
    err "токены не выводятся в терминал: eval \"\$(bin/harness secrets)\"" "tokens are not printed to a terminal: eval \"\$(bin/harness secrets)\""
    return 1
  fi
  st="$(bw_status | sed -n 1p)"; server="$(bw_status | sed -n 2p)"
  want="$(conf '.secrets.server')"
  if [ -n "$want" ] && [ "${server%/}" != "${want%/}" ]; then
    err "bw настроен на ${server:-облако Bitwarden}, а нужно $want: bw logout; bw config server $want; bw login" \
        "bw points to ${server:-the Bitwarden cloud}, expected $want: bw logout; bw config server $want; bw login"
    return 1
  fi
  case "$st" in
    unlocked) ;;
    locked) err "хранилище заблокировано: export BW_SESSION=\"\$(bw unlock --raw)\" и повтори" "the vault is locked: export BW_SESSION=\"\$(bw unlock --raw)\" and retry"; return 1 ;;
    *) err "bw не выполнил вход: bw config server ${want:-<адрес>}; bw login" "bw is not logged in: bw config server ${want:-<url>}; bw login"; return 1 ;;
  esac
  # Fresh data when the server answers; offline the local copy is used.
  bw sync >/dev/null 2>&1 || err "сервер хранилища недоступен — токены из локальной копии" "the vault server is unreachable — tokens come from the local copy"
  folder="$(conf '.secrets.folder')"; folder="${folder:-harness}"
  fid="$(bw list folders 2>/dev/null | jq -r --arg f "$folder" '.[] | select(.name == $f) | .id' | head -1)"
  [ -n "$fid" ] || { err "в хранилище нет папки «$folder»" "the vault has no folder \"$folder\""; return 1; }
  items="$(bw list items --folderid "$fid" 2>/dev/null)" || { err "bw list items не выполнился" "bw list items failed"; return 1; }
  vars="$(secret_vars)"
  for name in $vars; do
    # The value — the password of a login item or the notes of a secure note named exactly as the variable.
    val="$(printf '%s' "$items" | jq -r --arg n "$name" '[.[] | select(.name == $n) | (.login.password // .notes // empty)] | .[0] // empty')"
    if [ -z "$val" ]; then missing="$missing $name"; continue; fi
    found=$((found + 1))
    if [ "$check" -eq 1 ]; then ok "$name"; else printf 'export %s=%q\n' "$name" "$val"; fi
  done
  if [ -n "$missing" ]; then
    err "в папке «$folder» нет записей:$missing" "the folder \"$folder\" has no items:$missing"
    return 1
  fi
  [ "$check" -eq 0 ] || say "все токены на месте: $found" "all tokens are present: $found"
}

# --- Plane --------------------------------------------------------------------

# Days without movement after which a task in progress counts as stale.
PLANE_STALE_DAYS=7
# How often the session start refreshes the stale-task count in the background, in seconds.
PLANE_STALE_INTERVAL=3600

pl_ready() {
  need_jq
  integration_on plane || { err "интеграция plane не подключена: integrations.plane в harness.json" "the plane integration is not enabled: integrations.plane in harness.json"; return 1; }
  [ -n "${PLANE_TOKEN:-}" ] || { err "PLANE_TOKEN не задан в окружении" "PLANE_TOKEN is not set in the environment"; return 1; }
}

# pl_api <path inside the workspace> [curl args] — the token goes in a header and only to the Plane of this installation.
# Plane allows 60 requests a minute: on 429 the call waits and retries. A body is passed with -d, not stdin.
pl_api() {
  local url out code i
  url="$(conf '.integrations.plane.url')"
  url="${url%/}/api/v1/workspaces/$(conf '.integrations.plane.workspace')"
  for i in 1 2 3 4; do
    out="$(curl -sS --max-time 30 -w '\n%{http_code}' -H @<(printf 'X-API-Key: %s' "$PLANE_TOKEN") \
      -H 'Content-Type: application/json' "$url$1" "${@:2}")" || return 1
    code="${out##*$'\n'}"; out="${out%$'\n'*}"
    { [ "$code" = 429 ] && [ "$i" -lt 4 ]; } || break
    sleep $((i * 15))
  done
  printf '%s' "$out"
  case "$code" in 2??) return 0 ;; *) return 1 ;; esac
}

pl_fail() {
  local m
  m="$(printf '%s' "$1" | jq -rc '.error // .detail // .message // .' 2>/dev/null | cut -c1-300)"
  err "Plane: ${m:-нет ответа}" "Plane: ${m:-no response}"
  return 1
}

# pl_all <path> — every page of a list as one JSON array.
pl_all() {
  local cursor="" sep='?' res tmp
  case "$1" in *\?*) sep='&' ;; esac
  tmp="$(mktemp "${TMPDIR:-/tmp}/harness-plane.XXXXXX")" || return 1
  while :; do
    res="$(pl_api "$1${sep}per_page=100${cursor:+&cursor=$cursor}")" || { rm -f "$tmp"; pl_fail "$res"; return 1; }
    printf '%s' "$res" | jq -c '.results' >> "$tmp"
    [ "$(printf '%s' "$res" | jq -r '.next_page_results')" = true ] || break
    cursor="$(printf '%s' "$res" | jq -r '.next_cursor')"
  done
  jq -sc 'add // []' "$tmp"; rm -f "$tmp"
}

pl_url() { local u; u="$(conf '.integrations.plane.url')"; echo "${u%/}/$(conf '.integrations.plane.workspace')/browse/$1/"; }

# pl_group <name> — the state group by its name or a short alias.
pl_group() {
  case "$1" in
    backlog) echo backlog ;;
    todo|unstarted) echo unstarted ;;
    progress|in-progress|started) echo started ;;
    done|completed) echo completed ;;
    cancel|cancelled|canceled) echo cancelled ;;
    *) err "неизвестное состояние «$1»: backlog, todo, started, done, cancelled" "unknown state \"$1\": backlog, todo, started, done, cancelled"; return 1 ;;
  esac
}

# pl_item <IDENT-N> — the work item as JSON.
pl_item() {
  local res
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9]+-[0-9]+$' || { err "задача указывается как ПРОЕКТ-номер: $1" "a task is given as PROJECT-number: $1"; return 1; }
  res="$(pl_api "/work-items/$1/")" || { pl_fail "$res"; return 1; }
  printf '%s' "$res"
}

# pl_target <repository> <project identifier> — "<project id><TAB><label>": the project of the repository from the
# registry or the default one; a task about a repository gets the label repo:<name> in any project.
pl_target() {
  local repo="$1" ident="$2" pid
  if [ -n "$repo" ]; then
    need_registry
    jq -e --arg n "$repo" '.repos[] | select(.name == $n)' "$REGISTRY" >/dev/null || { err "репозитория $repo нет в реестре" "repository $repo is not in the registry"; return 1; }
    pid="$(jq -r --arg n "$repo" '.repos[] | select(.name == $n) | .plane_project_id // empty' "$REGISTRY")"
    [ -n "$pid" ] || pid="$(conf '.integrations.plane.default_project_id')"
    printf '%s\trepo:%s\n' "$pid" "$repo"
    return 0
  fi
  if [ -n "$ident" ]; then
    pid="$(pl_api "/projects/" | jq -r --arg i "$ident" '.results[] | select(.identifier == $i) | .id' | head -1)"
    [ -n "$pid" ] || { err "проекта $ident нет в Plane" "project $ident is not in Plane"; return 1; }
    printf '%s\t\n' "$pid"; return 0
  fi
  pid="$(conf '.integrations.plane.default_project_id')"
  [ -n "$pid" ] || { err "в harness.json нет integrations.plane.default_project_id" "harness.json has no integrations.plane.default_project_id"; return 1; }
  printf '%s\t\n' "$pid"
}

# pl_label_id <project id> <name> — the label id; the label is created when missing.
pl_label_id() {
  local id res
  id="$(pl_api "/projects/$1/labels/?per_page=100" | jq -r --arg n "$2" '.results[]? | select(.name == $n) | .id' | head -1)"
  if [ -z "$id" ]; then
    res="$(pl_api "/projects/$1/labels/" -X POST -d "$(jq -nc --arg n "$2" '{name: $n, color: "#64748b"}')")" || { pl_fail "$res"; return 1; }
    id="$(printf '%s' "$res" | jq -r '.id')"
  fi
  echo "$id"
}

# pl_set_state <project id> <item id> <group> — prints the name of the new state.
pl_set_state() {
  local states sid res
  states="$(pl_api "/projects/$1/states/")" || { pl_fail "$states"; return 1; }
  sid="$(printf '%s' "$states" | jq -r --arg g "$3" '[.results[] | select(.group == $g)] | sort_by(.sequence) | .[0].id // empty')"
  [ -n "$sid" ] || { err "в проекте нет состояния группы $3" "the project has no state of group $3"; return 1; }
  res="$(pl_api "/projects/$1/issues/$2/" -X PATCH -d "$(jq -nc --arg s "$sid" '{state: $s}')")" || { pl_fail "$res"; return 1; }
  printf '%s' "$states" | jq -r --arg s "$sid" '.results[] | select(.id == $s) | .name'
}

# pl_html <file> — HTML for Plane. A file that starts with a tag is taken as HTML; otherwise simple Markdown:
# paragraphs, "#" headings, "-" and "1." lists, `code` and **bold**. Whitespace between tags is dropped:
# Plane turns it into empty list items.
pl_html() {
  jq -Rrs '
    def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
    def inl: esc | gsub("`(?<c>[^`]+)`"; "<code>\(.c)</code>") | gsub("\\*\\*(?<b>[^*]+)\\*\\*"; "<strong>\(.b)</strong>");
    def blk: . as $l
      | if ($l | length) == 0 then ""
        elif ($l[0] | test("^#+ ")) then "<h3>" + ($l[0] | sub("^#+ +"; "") | inl) + "</h3>" + ($l[1:] | blk)
        elif ($l | all(test("^ *[-*] "))) then "<ul>" + ($l | map("<li>" + (sub("^ *[-*] "; "") | inl) + "</li>") | join("")) + "</ul>"
        elif ($l | all(test("^ *[0-9]+[.)] "))) then "<ol>" + ($l | map("<li>" + (sub("^ *[0-9]+[.)] "; "") | inl) + "</li>") | join("")) + "</ol>"
        else "<p>" + ($l | map(inl) | join("<br>")) + "</p>" end;
    if test("^\\s*<") then gsub(">\\s+<"; "><") | sub("^\\s+"; "") | sub("\\s+$"; "")
    else [splits("\n[ \t]*\n") | select(test("\\S")) | sub("^\n+"; "") | sub("\\s+$"; "") | split("\n") | blk] | join("") end' "$1"
}

task_usage() {
  err "использование:
  bin/harness task create --title <заголовок> --body-file <файл> [--repo <имя> | --project <ПРОЕКТ>] [--parent <ПРОЕКТ-N>] [--state <состояние>] [--priority none|low|medium|high|urgent]
  bin/harness task state <ПРОЕКТ-N> backlog|todo|started|done|cancelled
  bin/harness task comment <ПРОЕКТ-N> --body-file <файл>
  bin/harness task link <ПРОЕКТ-N> <url> [--title <название>]
  bin/harness task show <ПРОЕКТ-N>
  bin/harness task list [--repo <имя> | --project <ПРОЕКТ>] [--state <состояние>|open|all] [--limit N]" \
"usage:
  bin/harness task create --title <title> --body-file <file> [--repo <name> | --project <PROJECT>] [--parent <PROJECT-N>] [--state <state>] [--priority none|low|medium|high|urgent]
  bin/harness task state <PROJECT-N> backlog|todo|started|done|cancelled
  bin/harness task comment <PROJECT-N> --body-file <file>
  bin/harness task link <PROJECT-N> <url> [--title <title>]
  bin/harness task show <PROJECT-N>
  bin/harness task list [--repo <name> | --project <PROJECT>] [--state <state>|open|all] [--limit N]"
}

# task <action> … — work items in Plane: create, change the state, comment, link, show, list.
cmd_task() {
  local action="${1:-}"
  [ $# -gt 0 ] && shift
  case "$action" in
    create|state|comment|link|show|list) pl_ready || return 1; "task_$action" "$@" ;;
    *) task_usage; return 1 ;;
  esac
}

task_create() {
  local title="" body="" repo="" proj="" parent="" group=unstarted prio=none target pid label pj res id seq ident
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title="${2:-}"; shift 2 ;;
      --body-file) body="${2:-}"; shift 2 ;;
      --repo) repo="${2:-}"; shift 2 ;;
      --project) proj="${2:-}"; shift 2 ;;
      --parent) parent="${2:-}"; shift 2 ;;
      --state) group="${2:-}"; shift 2 ;;
      --priority) prio="${2:-}"; shift 2 ;;
      *) err "неизвестный ключ: $1" "unknown option: $1"; return 1 ;;
    esac
  done
  { [ -n "$title" ] && [ -n "$body" ]; } || { task_usage; return 1; }
  no_ai_text "$title" "$body" || return 1
  group="$(pl_group "$group")" || return 1
  case "$prio" in none|low|medium|high|urgent) ;; *) err "неизвестный приоритет: $prio" "unknown priority: $prio"; return 1 ;; esac
  target="$(pl_target "$repo" "$proj")" || return 1
  pid="${target%%$'\t'*}"; label="${target#*$'\t'}"
  pj="$(jq -nc --arg n "$title" --arg d "$(pl_html "$body")" --arg p "$prio" '{name: $n, description_html: $d, priority: $p}')"
  if [ -n "$parent" ]; then
    res="$(pl_item "$parent")" || return 1
    pj="$(printf '%s' "$pj" | jq -c --arg p "$(printf '%s' "$res" | jq -r '.id')" '. + {parent: $p}')"
  fi
  if [ -n "$label" ]; then
    res="$(pl_label_id "$pid" "$label")" || return 1
    pj="$(printf '%s' "$pj" | jq -c --arg l "$res" '. + {labels: [$l]}')"
  fi
  res="$(pl_api "/projects/$pid/issues/" -X POST -d "$pj")" || { pl_fail "$res"; return 1; }
  id="$(printf '%s' "$res" | jq -r '.id')"; seq="$(printf '%s' "$res" | jq -r '.sequence_id')"
  ident="$(pl_api "/projects/$pid/" | jq -r '.identifier')"
  # Plane ignores the state on creation and puts the item in Backlog: the state is set by a separate request.
  if [ "$group" != backlog ]; then pl_set_state "$pid" "$id" "$group" >/dev/null || return 1; fi
  echo "$ident-$seq $(pl_url "$ident-$seq")"
}

task_state() {
  local key="${1:-}" group item name
  { [ -n "$key" ] && [ -n "${2:-}" ]; } || { task_usage; return 1; }
  group="$(pl_group "$2")" || return 1
  item="$(pl_item "$key")" || return 1
  name="$(pl_set_state "$(printf '%s' "$item" | jq -r '.project')" "$(printf '%s' "$item" | jq -r '.id')" "$group")" || return 1
  echo "$key: $name"
}

task_comment() {
  local key="${1:-}" body="" item res
  [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --body-file) body="${2:-}"; shift 2 ;;
      *) err "неизвестный ключ: $1" "unknown option: $1"; return 1 ;;
    esac
  done
  { [ -n "$key" ] && [ -n "$body" ]; } || { task_usage; return 1; }
  no_ai_text "" "$body" || return 1
  item="$(pl_item "$key")" || return 1
  res="$(pl_api "/projects/$(printf '%s' "$item" | jq -r '.project')/issues/$(printf '%s' "$item" | jq -r '.id')/comments/" \
    -X POST -d "$(jq -nc --arg h "$(pl_html "$body")" '{comment_html: $h}')")" || { pl_fail "$res"; return 1; }
  say "$key: комментарий добавлен" "$key: comment added"
}

task_link() {
  local key="${1:-}" url="${2:-}" title="" item res
  [ $# -gt 1 ] && shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title="${2:-}"; shift 2 ;;
      *) err "неизвестный ключ: $1" "unknown option: $1"; return 1 ;;
    esac
  done
  { [ -n "$key" ] && [ -n "$url" ]; } || { task_usage; return 1; }
  item="$(pl_item "$key")" || return 1
  res="$(pl_api "/projects/$(printf '%s' "$item" | jq -r '.project')/issues/$(printf '%s' "$item" | jq -r '.id')/links/" \
    -X POST -d "$(jq -nc --arg u "$url" --arg t "$title" '{url: $u} + (if $t == "" then {} else {title: $t} end)')")" || { pl_fail "$res"; return 1; }
  say "$key: ссылка добавлена" "$key: link added"
}

task_show() {
  local key="${1:-}" item pid states labels comments
  [ -n "$key" ] || { task_usage; return 1; }
  item="$(pl_item "$key")" || return 1
  pid="$(printf '%s' "$item" | jq -r '.project')"
  states="$(pl_api "/projects/$pid/states/")" || { pl_fail "$states"; return 1; }
  labels="$(pl_api "/projects/$pid/labels/?per_page=100")" || labels='{}'
  comments="$(pl_api "/projects/$pid/issues/$(printf '%s' "$item" | jq -r '.id')/comments/" | jq '.results | length' 2>/dev/null)"
  printf '%s' "$item" | jq -r --argjson s "$states" --argjson l "$labels" --arg k "$key" --arg u "$(pl_url "$key")" \
    --arg c "${comments:-?}" --arg lang "$HLANG" '
    (.state as $id | $s.results[] | select(.id == $id) | .name) as $state
    | ([.labels[]? | if type == "object" then .name else (. as $id | $l.results[]? | select(.id == $id) | .name) end]
       | join(", ")) as $labels
    | if $lang == "ru" then
        "\($k) \(.name)\nсостояние: \($state) · приоритет: \(.priority) · обновлена: \(.updated_at[:10]) · комментариев: \($c)"
        + (if $labels != "" then "\nметки: \($labels)" else "" end) + "\n\($u)"
      else
        "\($k) \(.name)\nstate: \($state) · priority: \(.priority) · updated: \(.updated_at[:10]) · comments: \($c)"
        + (if $labels != "" then "\nlabels: \($labels)" else "" end) + "\n\($u)"
      end
    + (if (.description_stripped // "") != "" then "\n\n" + (.description_stripped | .[:800]) else "" end)'
}

task_list() {
  local repo="" proj="" state=open limit=50 target pid label ident items labels lid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="${2:-}"; shift 2 ;;
      --project) proj="${2:-}"; shift 2 ;;
      --state) state="${2:-}"; shift 2 ;;
      --limit) limit="${2:-}"; shift 2 ;;
      *) err "неизвестный ключ: $1" "unknown option: $1"; return 1 ;;
    esac
  done
  case "$state" in open|all) ;; *) state="$(pl_group "$state")" || return 1 ;; esac
  printf '%s' "$limit" | grep -Eq '^[0-9]+$' || { err "--limit — число" "--limit takes a number"; return 1; }
  target="$(pl_target "$repo" "$proj")" || return 1
  pid="${target%%$'\t'*}"; label="${target#*$'\t'}"
  ident="$(pl_api "/projects/$pid/" | jq -r '.identifier')"
  if [ -n "$label" ]; then
    labels="$(pl_api "/projects/$pid/labels/?per_page=100")" || { pl_fail "$labels"; return 1; }
    lid="$(printf '%s' "$labels" | jq -r --arg n "$label" '.results[] | select(.name == $n) | .id' | head -1)"
    [ -n "$lid" ] || { say "задач с меткой $label нет" "no tasks labelled $label"; return 0; }
  fi
  items="$(pl_all "/projects/$pid/issues/?expand=state&fields=id,sequence_id,name,state,updated_at,labels")" || return 1
  printf '%s' "$items" | jq -r --arg st "$state" --arg lid "$lid" --arg i "$ident" --argjson n "$limit" '
    def order: {"started": 0, "unstarted": 1, "backlog": 2, "completed": 3, "cancelled": 4}[.state.group];
    map(select(($st == "all") or ($st == "open" and (.state.group | IN("backlog", "unstarted", "started"))) or (.state.group == $st)))
    | map(select($lid == "" or ((.labels // []) | index($lid))))
    | sort_by(order, (.updated_at | explode | map(-.)))
    | .[:$n][] | "\($i)-\(.sequence_id)\t\(.state.name)\t\(.updated_at[:10])\t\(.name)"'
}

# tasks [--stale N] [--count] — tasks in progress across all projects and how many days they have not moved.
cmd_tasks() {
  local stale=0 count=0 projects p pid ident items out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --stale) stale="${2:-}"; shift 2 ;;
      --count) count=1; shift ;;
      *) err "неизвестный ключ: $1" "unknown option: $1"; return 1 ;;
    esac
  done
  printf '%s' "$stale" | grep -Eq '^[0-9]+$' || { err "--stale — число дней" "--stale takes a number of days"; return 1; }
  pl_ready || return 1
  projects="$(pl_api "/projects/")" || { pl_fail "$projects"; return 1; }
  for p in $(printf '%s' "$projects" | jq -r '.results[] | select(.archived_at == null) | "\(.id):\(.identifier)"'); do
    pid="${p%%:*}"; ident="${p#*:}"
    items="$(pl_all "/projects/$pid/issues/?expand=state&fields=id,sequence_id,name,state,updated_at,labels")" || return 1
    out="$out$(printf '%s' "$items" | jq -r --arg i "$ident" --argjson d "$stale" '
      def ts: (.[0:19] + "Z" | fromdateiso8601)
        - (.[19:] | sub("^\\.[0-9]+"; "") | if test("^[+-][0-9]{2}:[0-9]{2}$")
            then ((.[1:3] | tonumber) * 3600 + (.[4:6] | tonumber) * 60) * (if .[0:1] == "-" then -1 else 1 end) else 0 end);
      .[] | select(.state.group == "started") | ((now - (.updated_at | ts)) / 86400 | floor) as $days
      | select($days >= $d) | "\($days)\t\($i)-\(.sequence_id)\t\(.name)"')"$'\n'
  done
  out="$(printf '%s' "$out" | grep . | sort -t$'\t' -k1,1nr)"
  if [ "$count" -eq 1 ]; then printf '%s' "$out" | grep -c . ; return 0; fi
  [ -n "$out" ] || { say "задач в работе нет" "no tasks in progress"; return 0; }
  printf '%s\n' "$out" | while IFS=$'\t' read -r days key name; do
    printf '%-14s %4s %s  %s\n' "$key" "$days" "$(t 'дн.' 'd')" "$name"
  done
}

# The stale-task count for the session start: read from the cache, refreshed in the background so the start is not slowed.
stale_tasks_line() {
  local cache n age
  integration_on plane && [ -n "${PLANE_TOKEN:-}" ] || return 0
  cache="$(dirname "$(state_file x)")/plane-stale"
  age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || stat -f %m "$cache" 2>/dev/null || echo 0) ))
  if [ "$age" -gt "$PLANE_STALE_INTERVAL" ]; then
    ( n="$("$ROOT/bin/harness" tasks --stale "$PLANE_STALE_DAYS" --count 2>/dev/null)" \
        && printf '%s\n' "$n" > "$cache.tmp" && mv "$cache.tmp" "$cache" ) </dev/null >/dev/null 2>&1 &
  fi
  n="$(head -1 "$cache" 2>/dev/null | tr -cd '0-9')"
  [ "${n:-0}" -gt 0 ] || return 0
  say "в Plane задач в работе без движения дольше $PLANE_STALE_DAYS дн.: $n — bin/harness tasks --stale $PLANE_STALE_DAYS" \
      "Plane tasks in progress that have not moved for more than $PLANE_STALE_DAYS days: $n — bin/harness tasks --stale $PLANE_STALE_DAYS"
}

# --- Claude Code hooks --------------------------------------------------------

hook_session_start() {
  local version update problems context message sid="default" owner fetched=1 rc stale
  [ -t 0 ] || sid="$(jq -r '.session_id // "default"' 2>/dev/null)"
  # Version control of harness itself: the hooks from .githooks are enabled on every device.
  git -C "$ROOT" config --local core.hooksPath .githooks 2>/dev/null
  find "$(dirname "$(state_file x)")" -name 'update-check-*' -mtime +7 -delete 2>/dev/null
  ensure_data
  version="$(version_line)"
  context="$version"

  owner="$(conf '.owner.name')"
  if [ -n "$owner" ]; then
    context="$context"$'\n'"$(t "Владелец harness: $owner. Язык общения: русский." "Harness owner: $owner. Conversation language: English.")"
  else
    context="$context"$'\n'"$(t 'harness не настроен: владелец не задан. Скажи об этом пользователю и предложи выполнить bin/harness init; до этого не коммить.' 'harness is not set up: no owner is configured. Tell the user and suggest running bin/harness init; do not commit before that.')"
  fi
  # Rules and skills in .claude/ are a copy of i18n/<lang>: redeploy when they are missing or outdated.
  if [ -d "$I18N/$HLANG" ] && lang_stale "$HLANG" && apply_lang "$HLANG"; then
    context="$context"$'\n'"$(t 'Правила и skills только что развёрнуты из i18n в .claude/ — в начале сессии их в контексте могло не быть. Прочитай сейчас .claude/CLAUDE.md и все файлы .claude/rules/ и следуй им.' 'Rules and skills were just deployed from i18n to .claude/ — they may have been absent from the context at session start. Read .claude/CLAUDE.md and every file in .claude/rules/ now and follow them.')"
  fi
  # The session id for Docker labels (rules/docker.md): docker-clean tells its own resources from the neighbours'.
  if [ -n "${CLAUDE_ENV_FILE:-}" ] && [ "$sid" != default ]; then
    printf 'export HARNESS_SESSION=%q\n' "$(printf '%s' "$sid" | tr -cd 'A-Za-z0-9_-' | cut -c1-8)" >> "$CLAUDE_ENV_FILE"
  fi
  apply_identity; rc=$?
  if [ "$rc" -eq 2 ]; then
    if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
      printf 'export GIT_AUTHOR_NAME=%q GIT_COMMITTER_NAME=%q GIT_AUTHOR_EMAIL=%q GIT_COMMITTER_EMAIL=%q\n' \
        "$owner" "$owner" "$(conf '.owner.email')" "$(conf '.owner.email')" >> "$CLAUDE_ENV_FILE"
    fi
    context="$context"$'\n'"$(t 'Автор коммитов только что записан в .claude/settings.local.json. Перед первым коммитом в этой сессии проверь: git var GIT_AUTHOR_IDENT. Если автор не тот — попроси перезапустить сессию.' 'The commit author was just written to .claude/settings.local.json. Before the first commit in this session check: git var GIT_AUTHOR_IDENT. If the author is wrong, ask to restart the session.')"
  fi

  fetch_origin 15 || fetched=0
  echo "$(date +%s) $(git -C "$ROOT" rev-parse --quiet --verify "origin/$(default_branch)" 2>/dev/null)" > "$(state_file "$sid")"
  update="$(update_line)"
  problems="$(cmd_doctor --quiet 2>&1)"
  message="$version"
  [ -z "$update" ] || { message="$message · $update"; context="$context"$'\n'"$update"; }
  stale="$(stale_tasks_line)"
  [ -z "$stale" ] || { message="$message · $stale"; context="$context"$'\n'"$stale"; }
  [ "$fetched" -eq 1 ] || context="$context"$'\n'"$(t 'origin недоступен: наличие обновления не проверено.' 'origin is unreachable: the update check was skipped.')"
  if [ -n "$problems" ]; then
    message="$message · $(t 'окружение: есть замечания' 'environment: there are remarks')"
    context="$context"$'\n'"$(t 'Замечания doctor:' 'Doctor remarks:')"$'\n'"$problems"
  else
    context="$context"$'\n'"$(t 'Окружение в порядке (быстрая проверка).' 'The environment is fine (quick check).')"
  fi
  context="$context"$'\n'"$(t 'В первом ответе сообщи пользователю версию harness, наличие обновления и замечания doctor, если они есть.' 'In your first reply tell the user the harness version, whether an update is available, and the doctor remarks if there are any.')"
  jq -n --arg m "$message" --arg c "$context" \
    '{systemMessage: $m, hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $c}}'
}

# UserPromptSubmit: at most once per UPDATE_CHECK_INTERVAL looks whether a new version is out.
# Each new version is announced once, so a declined offer is not repeated.
hook_update_check() {
  local sid="default" file now last=0 offered="" remote update
  [ -t 0 ] || sid="$(jq -r '.session_id // "default"' 2>/dev/null)"
  file="$(state_file "$sid")"
  now="$(date +%s)"
  [ -f "$file" ] && read -r last offered < "$file"
  [ $((now - ${last:-0})) -ge "$UPDATE_CHECK_INTERVAL" ] || exit 0
  fetch_origin 12
  remote="$(git -C "$ROOT" rev-parse --quiet --verify "origin/$(default_branch)" 2>/dev/null)"
  echo "$now $remote" > "$file"
  [ -n "$remote" ] && [ "$remote" != "$offered" ] || exit 0
  update="$(update_line)"
  [ -n "$update" ] || exit 0
  jq -n --arg c "$(t "Сейчас работает $(version_line). В origin $update. В этом ответе сообщи об этом владельцу и предложи обновиться в текущей сессии через skill harness-update; без его согласия не обновляй." "Now running $(version_line). In origin: $update. In this reply tell the owner about it and offer to update in the current session through the harness-update skill; do not update without their consent.")" \
    '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: $c}}'
}

# git pre-commit in harness itself: every commit bumps VERSION and writes both changelogs.
hook_git_pre_commit() {
  local new old f mism
  new="$(git -C "$ROOT" show :VERSION 2>/dev/null | tr -d '[:space:]')"
  old="$(git -C "$ROOT" show HEAD:VERSION 2>/dev/null | tr -d '[:space:]')"
  if ! printf '%s' "$new" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    err "harness: VERSION должен быть вида X.Y.Z, сейчас «${new}»." "harness: VERSION must look like X.Y.Z, now \"$new\"."; exit 1
  fi
  if [ -n "$old" ] && ! ver_gt "$new" "$old"; then
    err "harness: каждый коммит поднимает версию. Сейчас v$old — увеличь VERSION, добавь запись в CHANGELOG.md и CHANGELOG.en.md и включи эти файлы в коммит." \
        "harness: every commit bumps the version. Now v$old — increase VERSION, add an entry to CHANGELOG.md and CHANGELOG.en.md and include these files in the commit."; exit 1
  fi
  for f in CHANGELOG.md CHANGELOG.en.md; do
    if ! git -C "$ROOT" show ":$f" 2>/dev/null | grep -Fq "## [$new]"; then
      err "harness: в $f нет записи «## [$new]»." "harness: $f has no \"## [$new]\" entry."; exit 1
    fi
  done
  mism="$(i18n_mismatch)"
  if [ -n "$mism" ]; then
    err "harness: языковые комплекты расходятся — нет пары у файлов:" "harness: the language sets differ — these files have no counterpart:"
    echo "$mism" >&2; exit 1
  fi
}

# git pre-push in harness itself: no outgoing commit may skip the version bump.
hook_git_pre_push() {
  local lsha rref rsha range sha bad=0
  while read -r _ lsha rref rsha; do
    case "$lsha" in *[!0]*) ;; *) continue ;; esac
    case "$rref" in
      refs/heads/*) ;;
      refs/tags/*)
        if [ "$(git -C "$ROOT" cat-file -t "$lsha" 2>/dev/null)" != "tag" ]; then
          err "harness: тег ${rref#refs/tags/} без описания. Создай аннотированный: git tag -a <тег> -m \"<описание>\"." \
              "harness: tag ${rref#refs/tags/} has no description. Create an annotated one: git tag -a <tag> -m \"<description>\"."; bad=1
        fi
        continue ;;
      *) continue ;;
    esac
    case "$rsha" in *[!0]*) range="$rsha..$lsha" ;; *) range="$lsha --not --remotes=origin" ;; esac
    # shellcheck disable=SC2086  # the range is two words when the branch is new
    for sha in $(git -C "$ROOT" rev-list --no-merges $range); do
      if [ -z "$(git -C "$ROOT" diff-tree --no-commit-id --name-only -r --root "$sha" -- VERSION)" ]; then
        err "harness: коммит $(git -C "$ROOT" log -1 --format='%h %s' "$sha") не поднимает VERSION." \
            "harness: commit $(git -C "$ROOT" log -1 --format='%h %s' "$sha") does not bump VERSION."; bad=1
      fi
    done
  done
  exit "$bad"
}

hook_subagent_start() {
  jq -n --arg c "$(t "Ты работаешь под управлением $(version_line). Правила harness обязательны и для тебя." "You are running under $(version_line). The harness rules are binding for you too.")" \
    '{hookSpecificOutput: {hookEventName: "SubagentStart", additionalContext: $c}}'
}

# --- repository locks ---------------------------------------------------------
# Several sessions share the clones in repos/. A session that starts changing a clone takes it:
# another session is refused and works in its own worktree instead (bin/harness worktree).

lock_dir() {
  local dir
  dir="${HARNESS_STATE_DIR:-$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null)/harness}/locks"
  mkdir -p "$dir" 2>/dev/null
  echo "$dir"
}

repo_default_branch() {
  local name="$1" def=""
  [ -f "$REGISTRY" ] && def="$(jq -r --arg n "$name" '.repos[]? | select(.name == $n) | .branch // empty' "$REGISTRY" 2>/dev/null)"
  [ -n "$def" ] || def="$(git -C "$REPOS_DIR/$name" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
  echo "${def:-main}"
}

# Names of the clones a command works with: the current directory, explicit repos/<name> paths
# and, when the command runs in repos/ itself or mentions it, bare clone names (loops over clones).
touched_repos() {
  local cmd="$1" cwd="$2" n
  {
    if [ "${cwd#"$REPOS_DIR"/}" != "$cwd" ]; then n="${cwd#"$REPOS_DIR"/}"; echo "${n%%/*}"; fi
    printf '%s' "$cmd" | grep -oE '(^|[^A-Za-z0-9._-])repos/[A-Za-z0-9._-]+' | sed -E 's|.*repos/||'
    # repos/$x, repos/"$x", repos/${x}: the name comes from a variable, so look for bare names.
    if [ "$cwd" = "$REPOS_DIR" ] || printf '%s' "$cmd" | grep -Eq "(^|[^A-Za-z0-9._-])repos/?([\"'[:space:];&|)\$]|\$)"; then
      for n in "$REPOS_DIR"/*/; do
        n="$(basename "$n")"
        printf '%s' "$cmd" | grep -Eq "(^|[[:space:]\"'=(/])$(printf '%s' "$n" | sed 's/[.]/\\./g')([[:space:]\"';)/]|\$)" && echo "$n"
      done
    fi
  } | sort -u | while IFS= read -r n; do
    [ -n "$n" ] && [ -e "$REPOS_DIR/$n/.git" ] && echo "$n"
  done
}

# repo_blocked <name> <session> [stay] — true when another session holds the clone. Sets LOCK_WHO,
# LOCK_BRANCH and LOCK_AGE for the message. A clone on its main branch with a clean tree is free.
# A clone left on a branch with no lock at all has an unknown owner: work may go on in that branch
# ("stay": edits, add, commit), but nothing may take the clone off it.
repo_blocked() {
  local name="$1" sid="$2" stay="${3:-}" file lsid="" lts=0 branch dirty now
  file="$(lock_dir)/$name"
  [ -f "$file" ] && read -r lsid lts _ < "$file"
  [ "$lsid" = "$sid" ] && return 1
  [ "$lsid" = "-" ] && return 1                       # released by the owner: bin/harness unlock
  branch="$(git -C "$REPOS_DIR/$name" branch --show-current 2>/dev/null)"
  dirty="$(git -C "$REPOS_DIR/$name" status --porcelain 2>/dev/null | head -1)"
  now="$(date +%s)"
  LOCK_WHO="${lsid:0:8}"; LOCK_BRANCH="${branch:-detached HEAD}"; LOCK_AGE=$(( (now - ${lts:-0}) / 60 ))
  if [ "$branch" != "$(repo_default_branch "$name")" ]; then
    [ -n "$lsid" ] && return 0
    LOCK_WHO="?"; LOCK_AGE="?"
    [ -n "$stay" ] && return 1
    return 0
  fi
  [ -n "$dirty" ] && [ -n "$lsid" ] && [ $((now - ${lts:-0})) -lt "$LOCK_TTL" ] && return 0
  return 1
}

lock_take() {
  printf '%s %s %s\n' "$2" "$(date +%s)" "$(git -C "$REPOS_DIR/$1" branch --show-current 2>/dev/null)" > "$(lock_dir)/$1"
}

lock_refuse() {
  err "harness: в repos/$1 работает другая сессия (сессия $LOCK_WHO, ветка $LOCK_BRANCH, активность $LOCK_AGE мин назад). Её ветку и файлы не трогай. Работай в своей копии: bin/harness worktree $1 <ветка> — и дальше в каталоге, который она напечатает. Блокировку сам не снимай (см. .claude/rules/git.md)." \
      "harness: another session works in repos/$1 (session $LOCK_WHO, branch $LOCK_BRANCH, active $LOCK_AGE min ago). Leave its branch and files alone. Work in your own copy: bin/harness worktree $1 <branch> — then in the directory it prints. Do not remove the lock yourself (see .claude/rules/git.md)."
}

# guard_repos <session> <command> <cwd> — the part of the Bash guard that protects shared clones.
guard_repos() {
  local sid="$1" cmd="$2" cwd="$3" name br args file lsid mine created stay=""
  mine="$(lock_dir)/branches-$(printf '%s' "$sid" | tr -cd 'A-Za-z0-9_-')"

  # Branches this session creates are remembered: only they may be deleted later.
  # The name is read from the command text, so a name the shell expands is refused up front:
  # the hook would never learn it and would later refuse to delete the branch.
  created="$({
    printf '%s' "$cmd" | grep -oE '(switch|checkout)[^|;&]*[[:space:]]-[cCbB][[:space:]]+[^[:space:];|&]+' | sed -E 's/.*[[:space:]]-[cCbB][[:space:]]+//'
    printf '%s' "$cmd" | grep -oE 'worktree[[:space:]]+add[^|;&]*[[:space:]]-[bB][[:space:]]+[^[:space:];|&]+' | sed -E 's/.*[[:space:]]-[bB][[:space:]]+//'
    printf '%s' "$cmd" | grep -oE 'harness"?[[:space:]]+worktree[[:space:]]+[^[:space:];|&]+[[:space:]]+[^[:space:];|&-][^[:space:];|&]*' | awk '{print $NF}'
  } | tr -d "\"'")"
  br="$(printf '%s\n' "$created" | grep '[$`{]' | head -1)"
  if [ -n "$br" ]; then
    err "harness: имя новой ветки «${br}» подставляет оболочка — хук не узнает настоящее имя и потом не даст удалить ветку. Назови ветку буквально, например: git switch -c fix-login." \
        "harness: the new branch name \"$br\" is expanded by the shell — the hook cannot learn the real name and will later refuse to delete the branch. Name the branch literally, e.g. git switch -c fix-login."
    exit 2
  fi
  [ -z "$created" ] || printf '%s\n' "$created" >> "$mine" 2>/dev/null

  if printf '%s' "$cmd" | grep -Eq 'git[^|;&]*[[:space:]]branch[^|;&]*[[:space:]](-[dD]|--delete)([[:space:]]|$)'; then
    args="$(printf '%s' "$cmd" | grep -oE 'branch[^|;&]*[[:space:]](-[dD]|--delete)[^;|&]*' | sed -E 's/^branch[^|;&]*[[:space:]](-[dD]|--delete)//' | tr -d "\"'")"
    [ -n "$(printf '%s' "$args" | tr -d '[:space:]')" ] || args='$'
    for br in $args; do
      case "$br" in -*|*'>'*|*'<'*) continue ;; esac
      if printf '%s' "$br" | grep -q '[$`{]' || ! grep -qxF "$br" "$mine" 2>/dev/null; then
        err "harness: ветку «${br}» создала не эта сессия — удалять её нельзя. Удаляй только свои ветки и называй их поимённо (см. .claude/rules/git.md)." \
            "harness: branch \"$br\" was not created by this session — it must not be deleted. Delete only your own branches and name each one (see .claude/rules/git.md)."
        exit 2
      fi
    done
  fi

  case "$cwd/" in "$WORKTREES_DIR"/*) return 0 ;; esac

  if ! printf '%s' "$cmd" | grep -Eq "$GIT_MUTATING"; then
    # Reading is free; it only shows that the session holding the clone is still alive.
    while IFS= read -r name; do
      file="$(lock_dir)/$name"; lsid=""
      [ -f "$file" ] && read -r lsid _ < "$file"
      [ "$lsid" = "$sid" ] && lock_take "$name" "$sid"
    done < <(touched_repos "$cmd" "$cwd")
    return 0
  fi

  printf '%s' "$cmd" | grep -Eq "$GIT_MOVING" || stay=1
  while IFS= read -r name; do
    if repo_blocked "$name" "$sid" "$stay"; then lock_refuse "$name"; exit 2; fi
    lock_take "$name" "$sid"
  done < <(touched_repos "$cmd" "$cwd")
}

# PreToolUse for Edit, Write and NotebookEdit: the same protection for direct file edits.
hook_guard_edit() {
  local input sid path name
  input="$(cat)"
  sid="$(printf '%s' "$input" | jq -r '.session_id // "default"')"
  path="$(printf '%s' "$input" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty')"
  [ "${path#"$REPOS_DIR"/}" != "$path" ] || exit 0
  name="${path#"$REPOS_DIR"/}"; name="${name%%/*}"
  [ -e "$REPOS_DIR/$name/.git" ] || exit 0
  if repo_blocked "$name" "$sid" stay; then lock_refuse "$name"; exit 2; fi
  lock_take "$name" "$sid"
  exit 0
}

cmd_locks() {
  local file name lsid lts branch state list="" now
  now="$(date +%s)"
  for file in "$(lock_dir)"/*; do
    [ -f "$file" ] || continue
    name="$(basename "$file")"
    case "$name" in branches-*) continue ;; esac
    [ -d "$REPOS_DIR/$name" ] || continue
    read -r lsid lts _ < "$file"
    [ "$lsid" = "-" ] && continue
    branch="$(git -C "$REPOS_DIR/$name" branch --show-current 2>/dev/null)"
    state="$(t 'чисто' 'clean')"
    [ -z "$(git -C "$REPOS_DIR/$name" status --porcelain 2>/dev/null | head -1)" ] || state="$(t 'есть правки' 'has changes')"
    if [ "$branch" = "$(repo_default_branch "$name")" ] && [ "$state" = "$(t 'чисто' 'clean')" ]; then continue; fi
    list="$list$name$US${lsid:0:8}$US${branch:-detached}$US$state$US$(( (now - ${lts:-0}) / 60 ))"$'\n'
  done
  if [ -z "$list" ]; then say "Занятых клонов нет." "No clones are held."; return 0; fi
  printf '%s\n%s' "$(t "РЕПОЗИТОРИЙ${US}СЕССИЯ${US}ВЕТКА${US}СОСТОЯНИЕ${US}МИНУТ НАЗАД" "REPOSITORY${US}SESSION${US}BRANCH${US}STATE${US}MINUTES AGO")" "$list" | print_table
}

cmd_unlock() {
  local name="${1:-}"
  if [ -z "$name" ] || [ ! -d "$REPOS_DIR/$name" ]; then err "укажи имя клона из repos/" "give the name of a clone in repos/"; exit 1; fi
  printf -- '- %s -\n' "$(date +%s)" > "$(lock_dir)/$name"
  say "Блокировка repos/$name снята: клон возьмёт первая сессия, которая начнёт в нём работать." \
      "The lock on repos/$name is removed: the first session that starts working there takes the clone."
}

# worktree <repo> <branch> [--remove] — a separate working copy of a clone for a parallel session.
# After a working copy is removed its branch goes too, but only when nothing in it would be lost:
# every commit is on a remote branch or, after a squash merge, has an equal change in the default branch.
# Otherwise the branch stays and the reason is printed. The shared clone may be held by another
# session, so the hook would not let the branch be deleted from there by hand.
worktree_drop_branch() {
  local name="$1" branch="$2" dir="$REPOS_DIR/$1" def left
  git -C "$dir" show-ref --verify --quiet "refs/heads/$branch" || return 0
  def="$(repo_default_branch "$name")"
  if [ "$branch" = "$def" ]; then return 0; fi
  if git -C "$dir" worktree list --porcelain | grep -qxF "branch refs/heads/$branch"; then
    say "Ветка $branch оставлена: она открыта в другой рабочей копии." "Branch $branch is kept: it is checked out in another working copy."
    return 0
  fi
  git -C "$dir" fetch --quiet --prune origin 2>/dev/null
  left="$(git -C "$dir" rev-list --count "$branch" --not --remotes 2>/dev/null)"
  if [ "${left:-1}" -gt 0 ] && git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$def"; then
    left="$(git -C "$dir" cherry "origin/$def" "$branch" 2>/dev/null | grep -c '^+')"
    # A squash merge of several commits: the whole change of the branch equals one commit of the default branch.
    if [ "$left" -gt 0 ] && worktree_squashed "$dir" "origin/$def" "$branch"; then left=0; fi
  fi
  if [ "${left:-1}" -gt 0 ]; then
    say "Ветка $branch оставлена: коммитов, которых нет в origin, — $left. Отправь их или удали ветку сам." \
        "Branch $branch is kept: $left commit(s) are not in origin. Push them or delete the branch yourself."
    return 0
  fi
  git -C "$dir" branch -D --quiet "$branch" >/dev/null && say "Ветка $branch удалена: всё из неё есть в origin." "Branch $branch is deleted: everything in it is in origin."
}

# worktree_squashed <clone> <default ref> <branch> — the change of the branch since the fork point is a commit of the default branch.
worktree_squashed() {
  local dir="$1" base want c
  base="$(git -C "$dir" merge-base "$2" "$3" 2>/dev/null)" || return 1
  want="$(git -C "$dir" diff "$base" "$3" | git patch-id --stable | cut -d' ' -f1)"
  [ -n "$want" ] || return 1
  for c in $(git -C "$dir" rev-list --no-merges "$base..$2" 2>/dev/null); do
    [ "$(git -C "$dir" show "$c" | git patch-id --stable | cut -d' ' -f1)" = "$want" ] && return 0
  done
  return 1
}

cmd_worktree() {
  local name="${1:-}" branch="${2:-}" remove="${3:-}" dir path def
  if [ -z "$name" ] || [ -z "$branch" ]; then err "использование: bin/harness worktree <репозиторий> <ветка> [--remove]" "usage: bin/harness worktree <repository> <branch> [--remove]"; exit 1; fi
  dir="$REPOS_DIR/$name"
  [ -e "$dir/.git" ] || { err "в repos/ нет клона «${name}»" "there is no clone \"$name\" in repos/"; exit 1; }
  path="$WORKTREES_DIR/$name/$(printf '%s' "$branch" | tr -c 'A-Za-z0-9._-' '-')"
  if [ "$remove" = "--remove" ]; then
    git -C "$dir" worktree remove "$path" || exit 1
    say "Рабочая копия удалена: $path" "The working copy is removed: $path"
    worktree_drop_branch "$name" "$branch"
    return 0
  fi
  if [ -d "$path" ]; then echo "$path"; return 0; fi
  mkdir -p "$(dirname "$path")"
  git -C "$dir" fetch --quiet origin 2>/dev/null
  if git -C "$dir" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$dir" worktree add --quiet "$path" "$branch" || exit 1
  else
    def="$(repo_default_branch "$name")"
    git -C "$dir" show-ref --verify --quiet "refs/remotes/origin/$def" && def="origin/$def"
    git -C "$dir" worktree add --quiet -b "$branch" "$path" "$def" || exit 1
  fi
  echo "$path"
}

# PreToolUse for Bash: does not let anyone swap the author or add AI attribution,
# and keeps sessions out of the clones other sessions work in.
hook_guard_bash() {
  local input cmd cwd f
  input="$(cat)"
  cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty')"
  cwd="$(printf '%s' "$input" | jq -r '.cwd // empty')"
  [ -n "$cmd" ] || exit 0

  guard_repos "$(printf '%s' "$input" | jq -r '.session_id // "default"')" "$cmd" "$cwd"

  # Token values reach the session only through the owner's shell: the agent may check names, not read values.
  # The command itself — «harness secrets» right after the program name, not a word «secrets» further on.
  if { printf '%s' "$cmd" | grep -Eq '(^|[;&|(`[:space:]])([^;&|(`[:space:]]*/)?harness[[:space:]]+secrets([[:space:]]|$|[;&|)`])' \
       && ! printf '%s' "$cmd" | grep -Eq '(^|[;&|(`[:space:]])([^;&|(`[:space:]]*/)?harness[[:space:]]+secrets[[:space:]]+--check'; } \
     || printf '%s' "$cmd" | grep -Eq '(^|[;&|(`[:space:]])bw[[:space:]]+(get|export|serve|unlock|list[[:space:]]+(items|send))([[:space:]]|$)'; then
    err "harness: значения токенов агенту не выдаются. Проверка имён — bin/harness secrets --check; токены в сессию приносит владелец: eval \"\$(bin/harness secrets)\" перед claude (см. .claude/rules/secrets.md)." \
        "harness: token values are not given to the agent. Names check — bin/harness secrets --check; the owner brings tokens into the session: eval \"\$(bin/harness secrets)\" before claude (see .claude/rules/secrets.md)."
    exit 2
  fi

  if printf '%s' "$cmd" | grep -Eq 'git[^|;&]* config[^|;&]* user\.(name|email)[[:space:]]+[^|;&[:space:]]|-c[[:space:]]+user\.(name|email)=|GIT_(AUTHOR|COMMITTER)_(NAME|EMAIL)=|--author[= ]'; then
    err "harness: автор коммитов берётся из harness.json и закреплён командой bin/harness init — менять его в команде нельзя (см. .claude/rules/git.md)." \
        "harness: the commit author comes from harness.json and is pinned by bin/harness init — it cannot be changed in a command (see .claude/rules/git.md)."
    exit 2
  fi

  printf '%s' "$cmd" | grep -Eq '(git[^|;&]*[[:space:]](commit|merge|tag|revert|cherry-pick|rebase)|gh[^|;&]*[[:space:]](pr|issue|release)|harness[^|;&]*[[:space:]](mr|release-create|task))([[:space:]]|$)' || exit 0

  if printf '%s' "$cmd" | grep -Eiq "$AI_MARKERS"; then
    err "harness: в сообщении коммита, тега или PR есть AI-атрибуция (Co-Authored-By, «Generated with», 🤖). Убери её и повтори (см. .claude/rules/git.md)." \
        "harness: the commit, tag or PR text contains AI attribution (Co-Authored-By, \"Generated with\", 🤖). Remove it and retry (see .claude/rules/git.md)."
    exit 2
  fi

  # Text passed as a file is checked by the file's contents.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ "$f" = "-" ] && continue
    case "$f" in /*) ;; *) f="$cwd/$f" ;; esac
    if [ ! -f "$f" ]; then
      err "harness: не могу проверить файл с текстом ($f). Укажи абсолютный путь к существующему файлу." \
          "harness: cannot check the text file ($f). Give an absolute path to an existing file."
      exit 2
    fi
    if grep -Eiq "$AI_MARKERS" "$f"; then
      err "harness: в файле $f есть AI-атрибуция (Co-Authored-By, «Generated with», 🤖). Убери её и повтори." \
          "harness: file $f contains AI attribution (Co-Authored-By, \"Generated with\", 🤖). Remove it and retry."
      exit 2
    fi
  done < <(printf '%s' "$cmd" | grep -oE '[[:space:]](-F|--file|--body-file|--notes-file)[= ]+[^[:space:];|&)]+' | sed -E 's/^[[:space:]]*(-F|--file|--body-file|--notes-file)[= ]+//' | tr -d "\"'")
  exit 0
}

# ------------------------------------------------------------------------------

case "${1:-}" in
  init)            shift; cmd_init "$@" ;;
  lang)            shift; cmd_lang "$@" ;;
  version)         cmd_version ;;
  doctor)          shift; cmd_doctor "$@" ;;
  selfcheck)       cmd_selfcheck ;;
  sync)            shift; cmd_sync "$@" ;;
  status)          cmd_status ;;
  servers)         cmd_servers ;;
  server-check)    shift; cmd_server_check "$@" ;;
  map)             shift; cmd_map "$@" ;;
  repo-remove)     shift; cmd_repo_remove "$@" ;;
  server-remove)   shift; cmd_server_remove "$@" ;;
  service-remove)  shift; cmd_service_remove "$@" ;;
  reset)           shift; cmd_reset "$@" ;;
  check-commits)   shift; cmd_check_commits "$@" ;;
  docker-up)       cmd_docker_up ;;
  docker-check)    cmd_docker_check ;;
  docker-clean)    shift; cmd_docker_clean "$@" ;;
  locks)           cmd_locks ;;
  unlock)          shift; cmd_unlock "$@" ;;
  worktree)        shift; cmd_worktree "$@" ;;
  forge)           shift; cmd_forge "$@" ;;
  mr)              shift; cmd_mr "$@" ;;
  mr-status)       shift; cmd_mr_status "$@" ;;
  release-create)  shift; cmd_release_create "$@" ;;
  task)            shift; cmd_task "$@" ;;
  secrets)         shift; cmd_secrets "$@" ;;
  tasks)           shift; cmd_tasks "$@" ;;
  release-build)   shift; cmd_release_build "$@" ;;
  release-publish) shift; cmd_release_publish "$@" ;;
  hook)
    case "${2:-}" in
      session-start)  hook_session_start ;;
      subagent-start) hook_subagent_start ;;
      guard-bash)     hook_guard_bash ;;
      guard-edit)     hook_guard_edit ;;
      update-check)   hook_update_check ;;
      git-pre-commit) hook_git_pre_commit ;;
      git-pre-push)   hook_git_pre_push ;;
      *) err "неизвестный хук: ${2:-}" "unknown hook: ${2:-}"; exit 1 ;;
    esac ;;
  ""|-h|--help|help) usage ;;
  *) err "неизвестная команда: $1" "unknown command: $1"; usage >&2; exit 1 ;;
esac
